---
// 根路径 / 重定向到默认语言首页 /zh/。
// output:static 下不可用 Astro.redirect()，故用 meta refresh + 兜底链接实现静态 301。
const DEFAULT_HOME = "/zh/";
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0; url=/zh/" />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={DEFAULT_HOME} />
    <title>理科迷 · LKM</title>
  </head>
  <body>
    <p>Redirecting to <a href={DEFAULT_HOME}>理科迷 · LKM</a>...</p>
  </body>
</html>
