---
import { getCollection } from "astro:content";
import OfficialLayout from "../../layouts/OfficialLayout.astro";
import HeroTyper from "../../components/HeroTyper.astro";
import Gallery from "../../components/Gallery.astro";
import Icon from "../../components/Icon.astro";
import { buildGalleryItems } from "../../data/gallery";
import { t } from "../../i18n/index";
import { langUrl } from "../../i18n/paths";

const lang = (Astro.currentLocale ?? "zh") as string;

import { getStaticPathsForLang } from "../../i18n/paths";
export const getStaticPaths = getStaticPathsForLang;

// 发展历程 · 时间线数据
const timelineItems = [
  { year: "2014.08.01", title: "可琪创立理科迷", description: "可琪创建了第一个群聊——〔理科迷宅基地〕，后几经更名，如〔理科α旗舰〕等。他是理科迷最初的创始人，社区现有的大部分框架与制度，都建立在他开创的基础之上。" },
  { year: "2014 ~ 2016", title: "群组扩张，与百度贴吧建立联系", description: "理科迷群组进入快速扩张期，从百度物理吧、数学吧、化学吧等社区吸收大量成员，其中与物理吧的联系最为密切。群友涵盖理科生与竞赛生，早期管理员团队也由活跃群友中选拔组建。" },
  { year: "2015 ~ 2016", title: "学科分群体系建立", description: "各学科分群陆续创立：数学（2015.12.22）、物理学、化学、生物学（2015.12.25），以及高中数学、物理、化学（2016.2.5），初中数学、生物（2016.2.4）。早期的学科分群体系初步成型。" },
  { year: "2016", title: "兴趣群组持续扩展", description: "物理部落群（2016.4.2）、信息技术群（2016.2.5）、科技世界群（2016.2.15）、心理学群（2016.10.7）等兴趣群组相继建立，社群生态进一步丰富。" },
  { year: "2017 ~ 2018", title: "网站规划与新闻社构想", description: "线上网站曾有过规划并短暂试运行，但未能正式搭建运营。同期设想的新闻社——用于发布科技资讯——也仅停留在纸面阶段，未最终落地。" },
  { year: "2018", title: "创始人淡出，花花接续坚守", description: "可琪因学业原因逐渐淡出，理科迷随之陷入低迷。现任团队组长花花接替创始人职责，每年自费维持理科迷的 SVIP 及物理部落的日常运营。后来腾讯部落功能下架，所有帖子一夜间消失，公众号也随之停用。" },
  { year: "2018.02", title: "七月团队早期架构建立", description: "七月团队·群务组（2018.2.19）与总务组（2018.2.21）相继成立，同期创办棋社、料理学、HIFI 等兴趣群。由可琪召集组建的早期管理团队，为后续的组织运转奠定了制度基础。" },
  { year: "2019.08.15", title: "千寻入群，短暂回暖", description: "千寻加入理科迷群聊，原本沉寂已久的群聊开始重现活力。" },
  { year: "2020", title: "再度沉寂：千寻备战中考", description: "千寻因年龄尚小、需全力备战中考，2020 年后逐渐淡出，群聊再度归于沉寂。理科迷历经聚散，一群人数跌落至仅 800 人。" },
  { year: "2024.04.19", title: "群管理的呼唤，重建之心萌芽", description: "群管理再次找到千寻，诉说群人数已不足 800、社区沉寂已久。千寻内心开始动摇，重建理科迷的念头悄然萌芽。" },
  { year: "2024.07.30", title: "下定决心，启动重建计划", description: "千寻正式下定决心重建并发展理科迷，开始向此前组织团队成员阐述视频宣传计划，为后续宣传攻势做铺垫。" },
  { year: "2024.08.10", title: "官方宣传账号成立，首条视频走红", description: "理科迷官方宣传账号正式上线，首条视频获 7800+ 播放量，社区迅速恢复活跃，理科迷迎来新生。" },
  { year: "2025.01.08", title: "官方群组重组", description: "重新组建理科迷官方群组，设立﹝理科迷·初中﹞与﹝理科迷·高中﹞两个分群，为不同学段的成员提供更精准的交流空间。" },
  { year: "2025.04", title: "团队组建与官网建设", description: "开始吸纳组建新团队，重新建设官网，打造面向社区内部的实用型知识平台。" },
  { year: "2025.04.02", title: "七月团队·活动策划部 成立", description: "组建﹝七月团队·活动策划部﹞，启动首次暑假活动策划。理科迷从线上交流走向有组织的活动运营，翻开新的一页。" },
  { year: "2025.07 ~ 2025.08", title: "第一次暑假活动落地", description: "首次暑假活动雏形落地。虽在组织细节上仍存不足，人手亦有待扩充，但这是一次珍贵的尝试，为后续活动积累了宝贵经验。" },
  { year: "2025.08.04", title: "网站遭删库，一切归零", description: "网站因意外被删库，所有数据丢失。这次事故让团队深刻认识到备份机制与运维规范的重要性，也成为后续重建的转折点。" },
  { year: "2026.06", title: "涅槃重生：官网重建与第二次暑假筹备", description: "汲取删库教训，以更稳健的架构重建官网与文件库。同期启动第二次暑假活动策划，理科迷以全新的姿态再度启程。" },
];

// 最近更新
const newsItems = [
  { title: "理科迷全新官网正式上线", date: "2026 年 08 月 01 日", desc: "以更稳健的架构重建官网，为你带来更好的在线体验。" },
  { title: "第二次暑假活动开始筹备", date: "2026 年 06 月 15 日", desc: "活动策划部已启动新一轮活动策划，敬请期待。" },
  { title: "官方群组重组完成", date: "2025 年 12 月 20 日", desc: "设立初中与高中两个分群，为不同学段成员提供更精准的交流空间。" },
  { title: "社区重建一周年回顾", date: "2025 年 08 月 04 日", desc: "从删库归零到涅槃重生，社区与大家一起走过的这一年。" },
  { title: "七月团队·活动策划部 成立", date: "2025 年 04 月 02 日", desc: "启动首次暑假活动策划，翻开社区活动运营新的一页。" },
  { title: "栏目「科技前沿」上线", date: "2025 年 01 月 08 日", desc: "聚焦前沿科学与技术，分享值得关注的科技资讯与思考。" },
];

// 团队成员
const teamMembers = [
  { name: "七月O", desc: "中国科学院国家天文台博士，引力波与黑洞物理方向", avatar: "/images/avatars/july-o.webp" },
  { name: "七月花", desc: "一个有理想的博士，梦想：每个孩子都能接触科学", avatar: "/images/avatars/july-hua.webp" },
  { name: "七月墨染", desc: "双非物理，卧薪尝胆三千日，大雪深埋终成金", avatar: "/images/avatars/july-moran.webp" },
  { name: "七月郁离", desc: "群务组组长，群务无小事，用心皆风景", avatar: "/images/avatars/july-yuli.webp" },
  { name: "七月有枝", desc: "前活动策划组组员，且停且忘且随风，且行且看且从容", avatar: "/images/avatars/july-youzhi.webp" },
];

// 推荐板块 4 卡
const exploreCards = [
  {
    href: "/communities",
    title: "基础学科",
    stats: "1.2k 成员 · 今日 45 帖",
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><circle cx="12" cy="12" r="3"></circle><path d="M12 2v4"></path><path d="M12 18v4"></path><path d="M2 12h4"></path><path d="M18 12h4"></path><path d="m4.93 4.93 2.83 2.83"></path><path d="m16.24 16.24 2.83 2.83"></path><path d="m4.93 19.07 2.83-2.83"></path><path d="m16.24 7.76 2.83-2.83"></path></svg>',
  },
  {
    href: "/communities",
    title: "应用学科",
    stats: "890 成员 · 今日 32 帖",
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><rect x="2" y="3" width="20" height="14" rx="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>',
  },
  {
    href: "/communities",
    title: "兴趣板块",
    stats: "520 成员 · 今日 28 帖",
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><circle cx="12" cy="12" r="10"></circle><path d="M8 14s1.5 2 4 2 4-2 4-2"></path><line x1="9" y1="9" x2="9.01" y2="9"></line><line x1="15" y1="9" x2="15.01" y2="9"></line></svg>',
  },
  {
    href: "/communities",
    title: "专栏",
    stats: "深度长文 · 专业认证",
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>',
  },
];

// 常见问题
const faqItems = [
  { title: "理科迷是什么？", description: "理科迷是一个由科技爱好者组成的社区，创立于 2014 年。我们打破专业门槛，让每一位热爱理性、崇尚科技的人都能在这里找到同频的伙伴，共同探索万物运转的奥秘。" },
  { title: "如何加入理科迷？", description: "你可以通过理科迷官方 QQ 群组加入我们。目前设有初中群和高中群两个分群，还有完整的基础学科和应用学科群，对不同学段、不同专业的成员提供更精准的交流空间。具体群号请查看联系我们页面。" },
  { title: "理科迷有哪些活动？", description: "理科迷定期举办假期活动、学科研讨会、科普内容创作等。七月团队·活动策划部负责统筹各项活动，欢迎关注官方宣传账号获取最新动态。" },
  { title: "如何参与社区建设？", description: "理科迷是一个共建共享的社区。你可以加入管理团队（总务部、群务部、新闻办等），也可以加入项目团队（教材编写项目组、科普产出项目组等），也可以投稿作品文章、参加活动、帮忙宣传和推广。" },
  { title: "理科迷有官网吗？", description: "是的。理科迷拥有官方网站，2026 年我们以更稳健的架构重建了官网，为你提供更好的在线体验。" },
  { title: "有问题或建议怎么联系？", description: "欢迎通过联系我们页面提交你的想法或问题。也可以直接在 QQ 群内向管理团队反馈，我们会认真对待每一条建议。" },
];

// 科学影像：复用 docs 集合里带封面图的文章
const allDocs = await getCollection("docs");
const galleryItems = buildGalleryItems(allDocs, lang === "en" ? "en" : "zh");
---

<OfficialLayout
  title={t(lang, "home.title")}
  description={t(lang, "seo.home")}
  includeWebsiteJsonLd
  currentPath="/"
  overlayHero
>
  <HeroTyper
    title={t(lang, "home.hero_title")}
    subtitle={t(lang, "home.hero_subtitle")}
    lead={t(lang, "home.hero_kicker")}
  />

  {/* ===== 推荐板块 ===== */}
  <section id="recommend" class="section-padding">
    <div class="container-x">
      <div class="mb-14 text-center">
        <h2
          class="title-underline text-[clamp(1.75rem,3vw,2.5rem)] font-bold text-deep-text"
        >
          {t(lang, "home.section_explore")}
        </h2>
        <p class="mt-8 text-text-muted">{t(lang, "home.section_explore_sub")}</p>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          exploreCards.map((c) => (
            <a href={langUrl(lang, c.href)} class="profile-card group no-underline">
              <div class="profile-inner flex flex-col items-center gap-2 p-5 text-center">
                <span class="icon-bubble h-12 w-12" set:html={c.icon} />
                <h3 class="font-semibold text-deep-text transition-colors group-hover:text-[var(--primary)]">
                  {c.title}
                </h3>
                <p class="text-xs text-text-muted">{c.stats}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* ===== 科学影像 ===== */}
  <section id="gallery" class="section-padding">
    <div class="container-x">
      <div class="mb-14 text-center">
        <h2
          class="title-underline text-[clamp(1.75rem,3vw,2.5rem)] font-bold text-deep-text"
        >
          {t(lang, "home.section_gallery")}
        </h2>
        <p class="mt-8 text-sm text-text-muted">{t(lang, "home.gallery_sub")}</p>
      </div>
      <Gallery items={galleryItems} />
    </div>
  </section>

  {/* ===== 团队成员 ===== */}
  <section id="team" class="section-padding">
    <div class="container-x">
      <div class="mb-14 text-center">
        <h2
          class="title-underline text-[clamp(1.75rem,3vw,2.5rem)] font-bold text-deep-text"
        >
          {t(lang, "home.section_team")}
        </h2>
        <p class="mt-8 text-text-muted">{t(lang, "home.section_team_sub")}</p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 md:gap-6 lg:grid-cols-3">
        {
          teamMembers.map((m) => (
            <a href={langUrl(lang, "/team")} class="profile-card no-underline">
              <div class="profile-inner flex flex-row items-center gap-3 rounded-lg p-4 text-left sm:flex-col sm:p-5 sm:text-center">
                <img
                  src={m.avatar}
                  alt={m.name}
                  width={96}
                  height={96}
                  class="h-10 w-10 shrink-0 rounded-full object-cover sm:mb-3 sm:h-16 sm:w-16"
                  loading="lazy"
                  decoding="async"
                />
                <div class="min-w-0 flex-1">
                  <h3 class="text-lg font-bold text-deep-text">{m.name}</h3>
                  <p class="mt-1 text-xs text-text-muted">{m.desc}</p>
                </div>
              </div>
            </a>
          ))
        }
        <a href={langUrl(lang, "/team")} class="profile-card no-underline">
          <div class="profile-inner flex min-h-full flex-col items-center justify-center gap-3 rounded-lg p-4 text-center sm:p-5">
            <span class="text-lg font-bold text-deep-text">
              {t(lang, "home.team_more")}
            </span>
            <span class="text-xs text-text-muted">
              {t(lang, "home.team_view_all_hint")}
            </span>
            <span class="btn btn-primary btn-sm">
              {t(lang, "home.team_view_all")}
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  {/* ===== 发展历程 · 钟表时间线 ===== */}
  <section id="timeline" class="section-padding">
    <div class="container-x">
      <div class="mb-14 text-center">
        <h2
          class="title-underline text-[clamp(1.75rem,3vw,2.5rem)] font-bold text-deep-text"
        >
          {t(lang, "home.section_timeline")}
        </h2>
        <p class="mt-8 text-text-muted">
          {t(lang, "home.section_timeline_sub")}
        </p>
      </div>

      <div class="ct-root" data-clock-timeline>
        <div class="ct-layout">
          <div class="ct-cards-col" data-ct-cards-col>
            <div class="ct-cards-viewport">
              <div class="ct-cards-track" data-ct-cards-track>
                {
                  timelineItems.map((item) => (
                    <div class="ct-card">
                      <div class="ct-card-body">
                        <div class="mb-2 font-mono text-[28px] font-bold text-[var(--primary)]">
                          {item.year}
                        </div>
                        {/* 标题用 h3：18 条时间线条目此前全是 div，读屏无法按标题跳转；
                            年份保持普通文本（它是 "2014 ~ 2016" 这类自由文本，不是合法 datetime，
                            因此不适合用 <time>） */}
                        <h3 class="mb-3 border-b border-[var(--primary)] pb-2 text-[30px] font-semibold text-deep-text">
                          {item.title}
                        </h3>
                        <div class="text-[15px] leading-relaxed text-text-muted">
                          {item.description}
                        </div>
                      </div>
                      <div class="ct-arrows ct-arrows-mobile">
                        <button
                          class="ct-arrow"
                          data-ct-arrow="prev"
                          aria-label={t(lang, "home.timeline_prev")}
                        >
                          <Icon name="chevronUp" class="h-6 w-6" />
                        </button>
                        <button
                          class="ct-arrow"
                          data-ct-arrow="next"
                          aria-label={t(lang, "home.timeline_next")}
                        >
                          <Icon name="chevronDown" class="h-6 w-6" />
                        </button>
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
            <div class="ct-arrows ct-arrows-desktop">
              <button
                class="ct-arrow"
                data-ct-arrow="prev"
                aria-label={t(lang, "home.timeline_prev")}
              >
                <Icon name="chevronUp" class="h-6 w-6" />
              </button>
              <button
                class="ct-arrow"
                data-ct-arrow="next"
                aria-label={t(lang, "home.timeline_next")}
              >
                <Icon name="chevronDown" class="h-6 w-6" />
              </button>
            </div>
          </div>

          {/* 钟面为可视化索引，其交互（切换当前条目）已由下方上一/下一按钮提供键盘入口，故对辅助技术隐藏 */}
          <div class="ct-clock-col" data-ct-clock-col aria-hidden="true">
            <div class="clock-face">
              <div class="clock-pointer" data-ct-pointer>
                <div class="clock-pointer-line"></div>
              </div>
              {
                timelineItems.map((item, i) => {
                  const step = 360 / timelineItems.length;
                  const year = (item.year.match(/^\d{4}/) || [item.year])[0];
                  return (
                    <div
                      class="clock-tick flex cursor-pointer items-center"
                      style={`transform: rotate(${i * step}deg)`}
                    >
                      <div
                        class="clock-tick-mark flex items-center justify-center"
                        data-ct-tick={i}
                      >
                        <span class="clock-tick-year leading-none">{year}</span>
                      </div>
                    </div>
                  );
                })
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ===== 最近更新 ===== */}
  <section id="update" class="section-padding">
    <div class="container-x">
      <div class="mb-14 text-center">
        <h2
          class="title-underline text-[clamp(1.75rem,3vw,2.5rem)] font-bold text-deep-text"
        >
          {t(lang, "home.section_updates")}
        </h2>
        <p class="mt-8 text-text-muted">
          {t(lang, "home.section_updates_sub")}
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          newsItems.map((n) => (
            <div class="card-hover rounded-2xl">
              <div class="flex flex-col gap-2 p-5">
                <span class="text-xs text-text-muted">{n.date}</span>
                <h3 class="text-[17px] leading-snug font-semibold text-deep-text">
                  {n.title}
                </h3>
                <p class="mt-1 text-sm leading-relaxed text-text-muted">
                  {n.desc}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ===== 常见问题 ===== */}
  <section id="faq" class="section-padding">
    <div class="container-x">
      <div class="mb-14 text-center">
        <h2
          class="title-underline text-[clamp(1.75rem,3vw,2.5rem)] font-bold text-deep-text"
        >
          {t(lang, "home.section_faq")}
        </h2>
        <p class="mt-8 leading-relaxed text-text-muted">
          {t(lang, "home.section_faq_sub")}
        </p>
      </div>

      <div class="mx-auto grid max-w-4xl gap-8 gap-y-8 sm:grid-cols-2 md:gap-y-12">
        {
          faqItems.map((item) => (
            <div>
              <div class="flex max-w-none flex-row">
                <Icon
                  name="chevronRight"
                  class="mr-2 mt-0.5 h-5 w-5 flex-shrink-0 text-[var(--primary)]"
                />
                <h3 class="text-[17px] leading-snug font-semibold text-deep-text">
                  {item.title}
                </h3>
              </div>
              <p class="mt-2 text-[14px] leading-relaxed text-text-muted">
                {item.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</OfficialLayout>

<script>
  // 钟表时间线交互（静态站无 Swup，首个 `<script>` 载入即初始化）
  document.addEventListener("DOMContentLoaded", () => {
    function initClockTimeline(root: HTMLElement): void {
      const track = root.querySelector("[data-ct-cards-track]") as HTMLElement;
      const clockCol = root.querySelector("[data-ct-clock-col]") as HTMLElement;
      const allPrevBtns = root.querySelectorAll("[data-ct-arrow='prev']");
      const allNextBtns = root.querySelectorAll("[data-ct-arrow='next']");
      if (!track || !clockCol || allPrevBtns.length === 0 || allNextBtns.length === 0) return;

      const cards = Array.from(track.querySelectorAll<HTMLElement>(".ct-card"));
      const total = cards.length;
      if (total === 0) return; // 空时间线：否则 angleStep 会是 Infinity
      let currentIndex = 0;
      const angleStep = 360 / total;

      function update(): void {
        // 用目标卡片相对首卡的实际偏移定位，而不是「首卡高度 × 索引」：卡片高度可能不等
        //（长文本、字体加载完成前后不同），一次性量出来的高度会随索引累积错位
        const offset = cards[currentIndex].offsetTop - cards[0].offsetTop;
        track.style.transform = `translate3d(0, -${offset}px, 0)`;
        const pointer = clockCol.querySelector(".clock-pointer") as HTMLElement;
        if (pointer) pointer.style.transform = `rotate(${currentIndex * angleStep}deg)`;
        clockCol.querySelectorAll("[data-ct-tick]").forEach((el) => {
          const idx = parseInt(el.getAttribute("data-ct-tick") || "0");
          el.classList.toggle("clock-tick-active", idx === currentIndex);
        });
      }

      allPrevBtns.forEach((btn) => btn.addEventListener("click", () => {
        currentIndex = currentIndex <= 0 ? total - 1 : currentIndex - 1;
        update();
      }));
      allNextBtns.forEach((btn) => btn.addEventListener("click", () => {
        currentIndex = currentIndex >= total - 1 ? 0 : currentIndex + 1;
        update();
      }));
      clockCol.querySelectorAll("[data-ct-tick]").forEach((tick) => tick.addEventListener("click", () => {
        const idx = parseInt(tick.getAttribute("data-ct-tick") || "0");
        currentIndex = idx;
        update();
      }));

      // 跨断点时卡片尺寸变化，按新尺寸重算偏移
      window.addEventListener("resize", update);
      update();
    }

    document.querySelectorAll("[data-clock-timeline]").forEach((el) => {
      initClockTimeline(el as HTMLElement);
    });
  });
</script>
