---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import OfficialLayout from "../../../layouts/OfficialLayout.astro";
import { SUPPORTED_LANGS } from "../../../i18n/index";
import { langUrl } from "../../../i18n/paths";
import { coverGradient, formatDate, readingMinutes } from "../../../components/news/format";

// docs 多语言存放于 src/content/docs/<lang>/<slug>.md（ID 如 `zh/news-site-launch`）。
export async function getStaticPaths() {
  const all = await getCollection("docs");

  // 按语言分桶
  const buckets = new Map<string, { doc: CollectionEntry<"docs">; slug: string }[]>();
  for (const d of all) {
    const lang = d.id.split("/")[0];
    if (!SUPPORTED_LANGS.includes(lang as (typeof SUPPORTED_LANGS)[number])) continue;
    const slug = d.id.split("/").slice(1).join("/");
    const bucket = buckets.get(lang) ?? [];
    bucket.push({ doc: d, slug });
    buckets.set(lang, bucket);
  }

  // 每语言内按 publishDate 升序 → 相邻两篇即为上/下一篇文章
  const paths: {
    params: { lang: string; slug: string };
    props: { doc: CollectionEntry<"docs">; lang: string; slug: string; prev: CollectionEntry<"docs"> | null; next: CollectionEntry<"docs"> | null };
  }[] = [];

  for (const [lang, bucket] of buckets) {
    bucket.sort((a, b) => a.doc.data.publishDate.getTime() - b.doc.data.publishDate.getTime());
    bucket.forEach((item, idx) => {
      paths.push({
        params: { lang, slug: item.slug },
        props: {
          doc: item.doc,
          lang,
          slug: item.slug,
          prev: idx > 0 ? bucket[idx - 1].doc : null,
          next: idx < bucket.length - 1 ? bucket[idx + 1].doc : null,
        },
      });
    });
  }
  return paths;
}

const { doc, lang, prev, next } = Astro.props as {
  doc: CollectionEntry<"docs">;
  lang: "zh" | "en";
  prev: CollectionEntry<"docs"> | null;
  next: CollectionEntry<"docs"> | null;
};
const { Content, headings } = await render(doc);
const en = lang === "en";

// 阅读目录在构建期由渲染后的标题生成，避免客户端构造 DOM 造成闪入
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 4);

const ymd = doc.data.publishDate.toISOString().slice(0, 10);
const dateText = formatDate(doc.data.publishDate, lang);
const minutes = readingMinutes(doc.body ?? "");
const metaMinutes = en ? `${minutes} min read` : `${minutes} 分钟阅读`;

const docLink = (e: CollectionEntry<"docs"> | null) =>
  e ? langUrl(lang, `/docs/${e.id.split("/").slice(1).join("/")}`) : null;
const prevHref = docLink(prev);
const nextHref = docLink(next);
---

<OfficialLayout
  title={doc.data.title}
  description={doc.data.description}
  type="article"
  publishedTime={doc.data.publishDate.toISOString()}
>
  <div class="mx-auto max-w-6xl gap-x-12 px-4 py-10 md:px-6 md:py-14 lg:grid lg:grid-cols-[minmax(0,1fr)_16rem]">
    <div class="min-w-0">
      <article class="article-prose">
        {/* 文章顶部配图（无 image 时才用标题色相渐变兜底） */}
        <div
          class="relative mb-8 aspect-[16/7] w-full overflow-hidden rounded-2xl border border-surface-3"
          style={doc.data.image ? undefined : { background: coverGradient(doc.data.title) }}
        >
          {doc.data.image && (
            <img
              src={doc.data.image}
              alt=""
              width="1200"
              height="525"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover"
            />
          )}
        </div>

        <a
          href={langUrl(lang, "/news")}
          class="inline-flex items-center gap-1 text-sm font-medium text-primary hover:underline"
        >
          {en ? "← Back to posts" : "← 返回文章"}
        </a>

        <header class="mt-6">
          <h1 class="font-heading text-3xl md:text-4xl font-bold leading-tight tracking-[-0.01em] text-deep-text">
            {doc.data.title}
          </h1>
          <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-text-muted">
            <time datetime={ymd}>{dateText}</time>
            <span class="h-1 w-1 rounded-full bg-surface-3" />
            <span>{metaMinutes}</span>
          </div>
          {doc.data.description && (
            <p class="mt-6 text-[17px] leading-relaxed text-text-muted">{doc.data.description}</p>
          )}
        </header>

        <div class="prose prose-neutral max-w-none prose-headings:text-deep-text prose-a:text-primary mt-8">
          <Content />
        </div>

        {(prevHref || nextHref) && (
          <nav
            class="mt-14 flex flex-col gap-3 border-t border-surface-3 pt-6 sm:flex-row sm:items-stretch sm:justify-between"
            aria-label="Previous or next post"
          >
            {prevHref && prev ? (
              <a
                href={prevHref}
                class="group inline-flex w-full flex-col gap-1 rounded-lg p-2 transition-colors hover:bg-surface-3/40 sm:w-[calc(50%-0.75rem)]"
              >
                <span class="text-xs uppercase tracking-wide text-text-muted">{en ? "Older" : "上一篇"}</span>
                <span class="text-sm font-semibold text-deep-text line-clamp-1 group-hover:text-primary">
                  {prev.data.title}
                </span>
              </a>
            ) : (
              <span class="hidden flex-1 sm:block" />
            )}

            {nextHref && next ? (
              <a
                href={nextHref}
                class="group inline-flex w-full flex-col items-end gap-1 rounded-lg p-2 text-right transition-colors hover:bg-surface-3/40 sm:w-[calc(50%-0.75rem)]"
              >
                <span class="text-xs uppercase tracking-wide text-text-muted">{en ? "Newer" : "下一篇"}</span>
                <span class="text-sm font-semibold text-deep-text line-clamp-1 group-hover:text-primary">
                  {next.data.title}
                </span>
              </a>
            ) : (
              <span class="hidden flex-1 sm:block" />
            )}
          </nav>
        )}
      </article>
    </div>

    {/* 右侧阅读目录（标题来自正文已渲染的 h2–h4，脚本实时填充） */}
    <aside class="hidden lg:block" aria-label={en ? "Table of contents" : "阅读目录"}>
      <div class="article-toc sticky top-24 max-h-[calc(100vh-8rem)] overflow-auto rounded-xl border border-surface-3 bg-card-bg p-5">
        <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-text-muted">
          {en ? "On this page" : "阅读目录"}
        </p>
        <nav data-toc-list class="space-y-1 text-sm">
          {
            tocHeadings.map((h) => (
              <a
                href={`#${h.slug}`}
                class:list={[
                  "toc-link block truncate rounded px-2 py-1 transition-colors",
                  h.depth === 3 && "pl-5",
                  h.depth === 4 && "pl-8",
                ]}
              >
                {h.text}
              </a>
            ))
          }
        </nav>
      </div>
    </aside>
  </div>
</OfficialLayout>

<script>
  // 目录链接已在构建期渲染，这里只做滚动高亮（原生锚点负责跳转）
  document.addEventListener("DOMContentLoaded", () => {
    const list = document.querySelector("[data-toc-list]") as HTMLElement | null;
    if (!list) return;

    const entries = Array.from(list.querySelectorAll<HTMLAnchorElement>("a"))
      .map((a) => {
        const id = decodeURIComponent(a.hash.slice(1));
        return { a, el: id ? document.getElementById(id) : null };
      })
      .filter((e): e is { a: HTMLAnchorElement; el: HTMLElement } => e.el !== null);
    if (entries.length === 0) return;

    const setActive = (idx: number) => {
      entries.forEach(({ a }, i) => a.classList.toggle("toc-active", i === idx));
    };

    let ticking = false;
    const pick = () => {
      ticking = false;
      let cur = 0;
      for (let i = 0; i < entries.length; i++) {
        if (entries[i].el.getBoundingClientRect().top <= 96) cur = i;
        else break;
      }
      setActive(cur);
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(pick);
        }
      },
      { passive: true },
    );
    pick();
  });
</script>

<style>
  /* 单篇 markdown 正文（收窄左列内）：prose 非侵入优化 */
  article.article-prose :where(h2) {
    margin-top: 2.25rem;
  }
  /* 锚点跳转时避开吸顶导航 */
  article.article-prose :where(h2, h3, h4) {
    scroll-margin-top: 5.5rem;
  }
  article.article-prose :where(blockquote) {
    border-inline-start: 3px solid var(--primary);
    border-radius: 0.25rem;
    background: color-mix(in oklch, var(--primary) 6%, transparent);
  }
  article.article-prose :where(pre) {
    border: 1px solid color-mix(in oklch, var(--text-muted) 20%, transparent);
    border-radius: 0.75rem;
  }
  article.article-prose :where(:not(pre) > code) {
    border-radius: 0.375rem;
    padding: 0.15em 0.3em;
    background: color-mix(in oklch, var(--primary) 10%, transparent);
  }
</style>

<style is:global>
  /* 右侧目录（渲染产物动态补入，需 global 命中） */
  .article-toc .toc-link {
    color: var(--text-muted);
    text-decoration: none;
  }
  .article-toc .toc-link:hover {
    background: color-mix(in oklch, var(--text-muted) 10%, transparent);
  }
  .article-toc .toc-link.toc-active {
    color: var(--primary);
    font-weight: 600;
    background: color-mix(in oklch, var(--primary) 10%, transparent);
  }
</style>
