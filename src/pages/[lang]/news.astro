---
import OfficialLayout from "../../layouts/OfficialLayout.astro";
import { getCollection } from "astro:content";
import { t } from "../../i18n/index";
import { langUrl } from "../../i18n/paths";
import NewsCard from "../../components/news/NewsCard.astro";
import { readingMinutes } from "../../components/news/format";

const lang = (Astro.currentLocale ?? "zh") as string;
const isEn = lang === "en";

import { getStaticPathsForLang } from "../../i18n/paths";
export const getStaticPaths = getStaticPathsForLang;

// ===== 文章（资讯）索引：列出来自 /zh(zh)|/en 下 category === "news" 的文章 =====
const allPosts = await getCollection("docs");

const posts = allPosts
  .filter((doc) => doc.id.startsWith(`${lang}/`) && doc.data.category === "news")
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const enEmpty = isEn && posts.length === 0;
---

<OfficialLayout
  title={t(lang, "news.title")}
  description={t(lang, "seo.news")}
  currentPath="/news"
>
  <div class="relative not-prose scroll-mt-[72px]">
    <div class="relative mx-auto max-w-7xl px-4 md:px-6 py-14 md:py-20">
      <header class="mb-8 md:mb-12 text-center">
        <h1 class="font-heading text-3xl md:text-[40px] font-bold text-deep-text tracking-[-0.01em]">
          {t(lang, "news.title")}
        </h1>
        <p class="mt-3 mx-auto max-w-2xl text-[15px] text-text-muted">
          {posts.length > 0
            ? `${posts.length} ${isEn ? "articles" : "篇文章"} · ${t(lang, "news.subtitle")}`
            : t(lang, "news.subtitle")}
        </p>
      </header>

      {enEmpty && (
        <div class="rounded-xl border border-surface-3 bg-card-bg px-6 py-12 text-center text-text-muted">
          {isEn
            ? "English translations are being prepared — check back soon."
            : "暂无文章。"}
        </div>
      )}

      {posts.length > 0 && (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((doc) => {
            const slug = doc.id.split("/").slice(1).join("/");
            const tagLabel = (doc.data.tags ?? [])[0];
            return (
              <NewsCard
                lang={isEn ? "en" : "zh"}
                href={langUrl(lang, `/docs/${slug}`)}
                title={doc.data.title}
                desc={doc.data.description}
                date={doc.data.publishDate}
                minutes={readingMinutes(doc.body ?? "")}
                tagLabel={tagLabel}
                image={doc.data.image}
              />
            );
          })}
        </div>
      )}
    </div>
  </div>
</OfficialLayout>
