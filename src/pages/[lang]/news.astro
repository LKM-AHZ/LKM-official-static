---
import OfficialLayout from "../../layouts/OfficialLayout.astro";
import { getCollection } from "astro:content";
import { t } from "../../i18n/index";
import { langUrl } from "../../i18n/paths";
import NewsCard from "../../components/news/NewsCard.astro";
import { readingMinutes } from "../../components/news/format";
import { getNewsPosts, postSlug } from "../../components/news/posts";
import { buildSearchText } from "../../components/news/search";
import { collectTags } from "../../components/news/tags";

const lang = (Astro.currentLocale ?? "zh") as string;
const isEn = lang === "en";

import { getStaticPathsForLang } from "../../i18n/paths";
export const getStaticPaths = getStaticPathsForLang;

// ===== 文章（资讯）索引：列出来自 /zh(zh)|/en 下 category === "news" 的文章 =====
const allPosts = await getCollection("docs");

const posts = getNewsPosts(allPosts, lang);

// 指南/文档与新闻分开成区：它们不进入新闻计数，但需要在文章页有固定入口，
// 否则新增的教程只能从详情页的上一篇/下一篇被发现。标签与搜索同时覆盖两区。
const guides = allPosts
  .filter(
    (doc) => doc.id.startsWith(`${lang}/`) && doc.data.category !== "news",
  )
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

// 标签去重并按热度排序，构建期渲染成筛选栏（客户端只切换选中态与显隐）
const tagCounts = collectTags([...posts, ...guides]);

const enEmpty = isEn && posts.length === 0;
---

<OfficialLayout
  title={t(lang, "news.title")}
  description={t(lang, "seo.news")}
  currentPath="/news"
>
  <section class="section-padding">
    <div class="container-x">
      <header class="mb-14 text-center">
        <h1
          class="title-underline font-heading text-section font-bold text-deep-text"
        >
          {t(lang, "news.title")}
        </h1>
        <p class="mx-auto mt-8 max-w-2xl text-lead text-text-muted">
          {
            posts.length > 0
              ? `${posts.length} ${isEn ? "news articles" : "篇新闻"} · ${t(lang, "news.subtitle")}`
              : t(lang, "news.subtitle")
          }
        </p>
      </header>

      {
        enEmpty && (
          <div class="card-hover rounded-2xl px-6 py-12 text-center text-text-muted">
            {isEn
              ? "English translations are being prepared — check back soon."
              : "暂无文章。"}
          </div>
        )
      }

      {
        posts.length > 0 && (
          <div class="mx-auto mb-10 w-full max-w-md">
            <input
              type="search"
              data-news-search
              aria-label={t(lang, "common.aria.search")}
              placeholder={t(lang, "news.search_placeholder")}
              class="w-full rounded-[var(--radius-field)] border border-[var(--card-edge)] bg-[var(--ghost-bg)] px-4 py-2.5 text-sm text-base-content transition outline-none focus:border-[var(--primary)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--primary)_25%,transparent)]"
            />
          </div>
        )
      }

      {
        /* 标签筛选栏：全部 + 每个标签（附文章数）。默认「全部」选中，
          点标签后与搜索框按 AND 共同过滤；选中态走 aria-pressed */
      }
      {
        tagCounts.length > 0 && (
          <div
            data-news-tagbar
            role="group"
            aria-label={t(lang, "news.tags_aria")}
            class="mx-auto mb-8 flex max-w-3xl flex-wrap items-center justify-center gap-2"
          >
            <button
              type="button"
              data-tag-filter=""
              aria-pressed="true"
              class="inline-flex items-center gap-1.5 rounded-full border border-[var(--card-edge)] bg-[var(--social-bg)] px-3 py-1 text-xs text-text-muted transition hover:border-[var(--primary)] hover:text-primary aria-pressed:border-[var(--primary)] aria-pressed:bg-[var(--social-hover-bg)] aria-pressed:font-medium aria-pressed:text-primary"
            >
              {t(lang, "news.tags_all")}
            </button>
            {tagCounts.map(({ tag, count }) => (
              <button
                type="button"
                data-tag-filter={tag}
                aria-pressed="false"
                class="inline-flex items-center gap-1.5 rounded-full border border-[var(--card-edge)] bg-[var(--social-bg)] px-3 py-1 text-xs text-text-muted transition hover:border-[var(--primary)] hover:text-primary aria-pressed:border-[var(--primary)] aria-pressed:bg-[var(--social-hover-bg)] aria-pressed:font-medium aria-pressed:text-primary"
              >
                {tag}
                <span class="text-[11px] opacity-70">{count}</span>
              </button>
            ))}
          </div>
        )
      }

      {
        /* 命中数：与列表的显隐一起由脚本维护，模板经 data 属性下发（客户端脚本取不到 t()） */
      }
      <p
        data-news-count
        data-count-template={t(lang, "news.search_count")}
        hidden
        aria-live="polite"
        class="mb-6 text-center text-sm text-text-muted"
      >
      </p>

      {
        posts.length > 0 && (
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-news-list>
            {posts.map((doc) => {
              const slug = postSlug(doc);
              return (
                <NewsCard
                  lang={isEn ? "en" : "zh"}
                  href={langUrl(lang, `/docs/${slug}`)}
                  title={doc.data.title}
                  desc={doc.data.description}
                  date={doc.data.publishDate}
                  minutes={readingMinutes(doc.body ?? "")}
                  tags={doc.data.tags ?? []}
                  image={doc.data.image}
                  searchText={buildSearchText([
                    doc.data.title,
                    doc.data.description,
                    ...(doc.data.tags ?? []),
                  ])}
                />
              );
            })}
          </div>
        )
      }

      <p
        data-news-empty
        hidden
        class="card-hover rounded-2xl px-6 py-12 text-center text-text-muted"
      >
        {t(lang, "news.search_empty")}
      </p>

      {
        guides.length > 0 && (
          <section
            data-guides-section
            aria-labelledby="guides-title"
            class="mt-20 border-t border-[var(--card-edge)] pt-14"
          >
            <header class="mb-8 flex flex-wrap items-end justify-between gap-4">
              <div>
                <h2 id="guides-title" class="text-2xl font-bold text-deep-text">
                  {t(lang, "news.guides_title")}
                </h2>
                <p class="mt-3 text-note text-text-muted">
                  {t(lang, "news.guides_subtitle")}
                </p>
              </div>
              <span
                data-guides-count
                data-count-template={isEn ? "{n} docs" : "{n} 篇文档"}
                class="text-sm text-text-muted"
              >
                {guides.length} {isEn ? "docs" : "篇文档"}
              </span>
            </header>

            <div data-guides-list class="grid gap-5 sm:grid-cols-2">
              {guides.map((doc) => {
                const slug = postSlug(doc);
                return (
                  <NewsCard
                    kind="guide"
                    headingLevel={3}
                    lang={isEn ? "en" : "zh"}
                    href={langUrl(lang, `/docs/${slug}`)}
                    title={doc.data.title}
                    desc={doc.data.description}
                    date={doc.data.publishDate}
                    minutes={readingMinutes(doc.body ?? "")}
                    tags={doc.data.tags ?? []}
                    image={doc.data.image}
                    searchText={buildSearchText([
                      doc.data.title,
                      doc.data.description,
                      ...(doc.data.tags ?? []),
                    ])}
                  />
                );
              })}
            </div>
          </section>
        )
      }
    </div>
  </section>
</OfficialLayout>

<script>
  import { matchesQuery } from "../../components/news/search";
  import { matchesTag, pickTagFromSearch } from "../../components/news/tags";

  const input = document.querySelector<HTMLInputElement>("[data-news-search]");
  const list = document.querySelector<HTMLElement>("[data-news-list]");
  const guidesList = document.querySelector<HTMLElement>("[data-guides-list]");

  if (input && list) {
    const cards = Array.from(
      list.querySelectorAll<HTMLElement>('[data-card-kind="news"]'),
    );
    const guideCards = guidesList
      ? Array.from(
          guidesList.querySelectorAll<HTMLElement>('[data-card-kind="guide"]'),
        )
      : [];
    const empty = document.querySelector<HTMLElement>("[data-news-empty]");
    const count = document.querySelector<HTMLElement>("[data-news-count]");
    const guidesSection = document.querySelector<HTMLElement>(
      "[data-guides-section]",
    );
    const guidesCount = document.querySelector<HTMLElement>(
      "[data-guides-count]",
    );
    const tagButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-tag-filter]"),
    );

    // 初始标签来自 URL（详情页点标签跳过来时带着 ?tag=）。
    // 只认筛选栏里存在的标签，链接过期/手改 URL 时按「全部」处理，避免整页空结果。
    let activeTag = pickTagFromSearch(location.search);
    if (
      activeTag &&
      !tagButtons.some((b) => b.dataset.tagFilter === activeTag)
    ) {
      activeTag = "";
    }

    const syncButtons = (): void => {
      for (const btn of tagButtons) {
        btn.setAttribute(
          "aria-pressed",
          String((btn.dataset.tagFilter ?? "") === activeTag),
        );
      }
    };

    const updateUrl = (): void => {
      const url = new URL(location.href);
      if (activeTag) url.searchParams.set("tag", activeTag);
      else url.searchParams.delete("tag");
      history.replaceState(null, "", url);
    };

    const apply = (): void => {
      const query = input.value;
      const hasQuery = query.trim() !== "";
      let shownNews = 0;
      for (const card of cards) {
        const tags: string[] = card.dataset.tags
          ? (JSON.parse(card.dataset.tags) as string[])
          : [];
        const hit =
          matchesQuery(card.dataset.searchText ?? "", query) &&
          matchesTag(tags, activeTag);
        card.hidden = !hit;
        if (hit) shownNews += 1;
      }

      // 文档区与新闻共用同一套搜索词与标签过滤
      let shownGuides = 0;
      for (const card of guideCards) {
        const tags: string[] = card.dataset.tags
          ? (JSON.parse(card.dataset.tags) as string[])
          : [];
        const hit =
          matchesQuery(card.dataset.searchText ?? "", query) &&
          matchesTag(tags, activeTag);
        card.hidden = !hit;
        if (hit) shownGuides += 1;
      }

      const filtering = hasQuery || activeTag !== "";
      const shown = shownNews + shownGuides;

      // 搜索与标签都是整页范围，计数按两区可见内容算；空状态只在整页无结果时出现
      if (empty) empty.hidden = !filtering || shown > 0;
      if (guidesSection) {
        guidesSection.hidden = filtering && shownGuides === 0;
      }
      if (guidesCount) {
        const guidesShown = filtering ? shownGuides : guideCards.length;
        guidesCount.textContent = (
          guidesCount.dataset.countTemplate ?? "{n}"
        ).replace("{n}", String(guidesShown));
      }
      if (count) {
        count.hidden = !filtering || shown === 0;
        if (filtering) {
          count.textContent = (count.dataset.countTemplate ?? "{n}").replace(
            "{n}",
            String(shown),
          );
        }
      }
    };

    for (const btn of tagButtons) {
      btn.addEventListener("click", () => {
        activeTag = btn.dataset.tagFilter ?? "";
        syncButtons();
        updateUrl();
        apply();
      });
    }
    input.addEventListener("input", apply);

    syncButtons();
    apply();
  }
</script>

<style is:global>
  /* 卡片根元素带 flex 类，与 UA 样式表的 [hidden]{display:none} 同为 (0,1,0)
     特异性却属作者样式，会盖掉后者，使过滤后的卡片只是「不该显示」而非隐藏。
     这里显式提权。用 is:global 是因为卡片由 NewsCard 子组件渲染，
     不带本页的 scope 属性，scoped 样式选不中它。 */
  [data-news-list] > [hidden],
  [data-guides-list] > [hidden] {
    display: none;
  }
</style>
