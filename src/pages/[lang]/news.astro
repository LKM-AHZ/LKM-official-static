---
import OfficialLayout from "../../layouts/OfficialLayout.astro";
import { getCollection } from "astro:content";
import { t } from "../../i18n/index";
import ArticleModule from "../../components/news/ArticleModule.astro";
import { getNewsPosts } from "../../components/news/posts";
import { collectTags } from "../../components/news/tags";

const lang = (Astro.currentLocale ?? "zh") as string;
const isEn = lang === "en";

import { getStaticPathsForLang } from "../../i18n/paths";
export const getStaticPaths = getStaticPathsForLang;

// ===== 文章页：新闻与指南/文档两个模块，共用卡片、分页与整页搜索/标签 =====
const allPosts = await getCollection("docs");
const posts = getNewsPosts(allPosts, lang);

const guides = allPosts
  .filter(
    (doc) => doc.id.startsWith(`${lang}/`) && doc.data.category !== "news",
  )
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

// 标签栏放在两个模块之外，同时统计新闻与文档
const tagCounts = collectTags([...posts, ...guides]);

// 两个模块每页都显示 6 篇；当前内容不足 7 篇时仍显示 1 / 1 的分页条
const PAGE_SIZE = 6;
---

<OfficialLayout
  title={t(lang, "news.page_title")}
  description={t(lang, "seo.news")}
  currentPath="/news"
>
  <section class="section-padding">
    <div class="container-x">
      <header class="mb-10 text-center">
        <h1 class="title-underline font-heading text-section font-bold text-deep-text">
          {t(lang, "news.page_title")}
        </h1>
        <p class="mx-auto mt-8 max-w-2xl text-lead text-text-muted">
          {t(lang, "news.page_subtitle")}
        </p>
      </header>

      {/* 搜索与标签是整页工具条，位于两个模块之外，同时过滤新闻与文档 */}
      <div class="mx-auto w-full max-w-3xl">
        <input
          type="search"
          data-news-search
          aria-label={t(lang, "common.aria.search")}
          placeholder={t(lang, "news.search_placeholder")}
          class="w-full rounded-[var(--radius-field)] border border-[var(--card-edge)] bg-[var(--ghost-bg)] px-4 py-2.5 text-sm text-base-content transition outline-none focus:border-[var(--primary)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--primary)_25%,transparent)]"
        />

        {tagCounts.length > 0 && (
          <div
            data-news-tagbar
            role="group"
            aria-label={t(lang, "news.tags_aria")}
            class="mx-auto mt-6 flex max-w-3xl flex-wrap items-center justify-center gap-2"
          >
            <button
              type="button"
              data-tag-filter=""
              aria-pressed="true"
              class="inline-flex items-center gap-1.5 rounded-full border border-[var(--card-edge)] bg-[var(--social-bg)] px-3 py-1 text-xs text-text-muted transition hover:border-[var(--primary)] hover:text-primary aria-pressed:border-[var(--primary)] aria-pressed:bg-[var(--social-hover-bg)] aria-pressed:font-medium aria-pressed:text-primary"
            >
              {t(lang, "news.tags_all")}
            </button>
            {tagCounts.map(({ tag, count }) => (
              <button
                type="button"
                data-tag-filter={tag}
                aria-pressed="false"
                class="inline-flex items-center gap-1.5 rounded-full border border-[var(--card-edge)] bg-[var(--social-bg)] px-3 py-1 text-xs text-text-muted transition hover:border-[var(--primary)] hover:text-primary aria-pressed:border-[var(--primary)] aria-pressed:bg-[var(--social-hover-bg)] aria-pressed:font-medium aria-pressed:text-primary"
              >
                {tag}
                <span class="text-[11px] opacity-70">{count}</span>
              </button>
            ))}
          </div>
        )}

        {/* 命中总数：整页范围，由客户端脚本维护；模块自己的计数在模块头部 */}
        <p
          data-news-count
          data-count-template={t(lang, "news.search_count")}
          hidden
          aria-live="polite"
          class="mt-6 text-center text-sm text-text-muted"
        ></p>
      </div>

      <ArticleModule
        id="news"
        lang={isEn ? "en" : "zh"}
        title={t(lang, "news.title")}
        subtitle={t(lang, "news.subtitle")}
        items={posts}
        kind="news"
        unit="news"
        pageSize={PAGE_SIZE}
        emptyText={t(lang, "news.search_empty")}
      />

      <ArticleModule
        id="guides"
        lang={isEn ? "en" : "zh"}
        title={t(lang, "news.guides_title")}
        subtitle={t(lang, "news.guides_subtitle")}
        items={guides}
        kind="guide"
        unit="docs"
        pageSize={PAGE_SIZE}
        emptyText={t(lang, "news.search_empty")}
      />
    </div>
  </section>
</OfficialLayout>

<script>
  import { matchesQuery } from "../../components/news/search";
  import { matchesTag, pickTagFromSearch } from "../../components/news/tags";

  const input = document.querySelector<HTMLInputElement>("[data-news-search]");
  const toolbarCount = document.querySelector<HTMLElement>("[data-news-count]");

  interface ModuleState {
    cards: HTMLElement[];
    count: HTMLElement | null;
    empty: HTMLElement | null;
    pager: HTMLElement | null;
    prev: HTMLButtonElement | null;
    next: HTMLButtonElement | null;
    info: HTMLElement | null;
    pageSize: number;
    page: number;
    totalPages: number;
  }

  const modules: ModuleState[] = Array.from(
    document.querySelectorAll<HTMLElement>("[data-module]"),
  ).map((root) => {
    const list = root.querySelector<HTMLElement>("[data-module-list]");
    return {
      cards: list
        ? Array.from(list.querySelectorAll<HTMLElement>("[data-card-kind]"))
        : [],
      count: root.querySelector<HTMLElement>("[data-module-count]"),
      empty: root.querySelector<HTMLElement>("[data-module-empty]"),
      pager: root.querySelector<HTMLElement>("[data-module-pager]"),
      prev: root.querySelector<HTMLButtonElement>("[data-page-prev]"),
      next: root.querySelector<HTMLButtonElement>("[data-page-next]"),
      info: root.querySelector<HTMLElement>("[data-page-info]"),
      pageSize: Number(root.dataset.pageSize ?? 6) || 6,
      page: 1,
      totalPages: 1,
    };
  });

  if (input && modules.length > 0) {
    const tagButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-tag-filter]"),
    );

    // 初始标签来自 URL（详情页点标签跳过来时带着 ?tag=）。
    // 只认筛选栏里存在的标签，链接过期/手改 URL 时按「全部」处理，避免整页空结果。
    let activeTag = pickTagFromSearch(location.search);
    if (
      activeTag &&
      !tagButtons.some((b) => b.dataset.tagFilter === activeTag)
    ) {
      activeTag = "";
    }

    const syncButtons = (): void => {
      for (const btn of tagButtons) {
        btn.setAttribute(
          "aria-pressed",
          String((btn.dataset.tagFilter ?? "") === activeTag),
        );
      }
    };

    const updateUrl = (): void => {
      const url = new URL(location.href);
      if (activeTag) url.searchParams.set("tag", activeTag);
      else url.searchParams.delete("tag");
      history.replaceState(null, "", url);
    };

    // resetPages: 搜索/标签变化时两个模块都回到第 1 页；点翻页按钮时保持当前页
    const apply = (resetPages = false): void => {
      const query = input.value;
      const filtering = query.trim() !== "" || activeTag !== "";
      let totalShown = 0;

      for (const module of modules) {
        const matches = module.cards.filter((card) => {
          const tags: string[] = card.dataset.tags
            ? (JSON.parse(card.dataset.tags) as string[])
            : [];
          return (
            matchesQuery(card.dataset.searchText ?? "", query) &&
            matchesTag(tags, activeTag)
          );
        });

        if (resetPages) module.page = 1;
        module.totalPages = Math.max(
          1,
          Math.ceil(matches.length / module.pageSize),
        );
        if (module.page > module.totalPages) module.page = module.totalPages;

        const start = (module.page - 1) * module.pageSize;
        const pageCards = new Set(
          matches.slice(start, start + module.pageSize),
        );
        for (const card of module.cards) card.hidden = !pageCards.has(card);

        if (module.count) {
          module.count.textContent = (
            module.count.dataset.countTemplate ?? "{n}"
          ).replace("{n}", String(matches.length));
        }
        if (module.empty) module.empty.hidden = matches.length > 0;
        if (module.pager) module.pager.hidden = matches.length === 0;
        if (module.info) {
          module.info.textContent = `${module.page} / ${module.totalPages}`;
        }
        if (module.prev) module.prev.disabled = module.page <= 1;
        if (module.next)
          module.next.disabled = module.page >= module.totalPages;

        totalShown += matches.length;
      }

      if (toolbarCount) {
        toolbarCount.hidden = !filtering;
        if (filtering) {
          toolbarCount.textContent = (
            toolbarCount.dataset.countTemplate ?? "{n}"
          ).replace("{n}", String(totalShown));
        }
      }
    };

    for (const module of modules) {
      module.prev?.addEventListener("click", () => {
        if (module.page > 1) {
          module.page -= 1;
          apply();
        }
      });
      module.next?.addEventListener("click", () => {
        if (module.page < module.totalPages) {
          module.page += 1;
          apply();
        }
      });
    }

    for (const btn of tagButtons) {
      btn.addEventListener("click", () => {
        activeTag = btn.dataset.tagFilter ?? "";
        syncButtons();
        updateUrl();
        apply(true);
      });
    }
    input.addEventListener("input", () => apply(true));

    syncButtons();
    apply(true);
  }
</script>

<style is:global>
  /* 卡片根元素带 flex 类，作者样式的 display 会盖过 UA 的 [hidden]{display:none}；
     这里显式提权，分页与搜索隐藏卡片时才真正生效。 */
  [data-module-list] > [hidden] {
    display: none;
  }
</style>
