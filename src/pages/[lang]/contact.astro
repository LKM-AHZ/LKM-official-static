---
import OfficialLayout from "../../layouts/OfficialLayout.astro";
import Icon from "../../components/Icon.astro";
import { t } from "../../i18n/index";
import { getStaticPathsForLang, langUrl } from "../../i18n/paths";

const lang = (Astro.currentLocale ?? "zh") as string;

export const getStaticPaths = getStaticPathsForLang;

// ===== 联系我们页（复刻主应用 /official/contact，静态展示）=====

const contactItems = [
  { icon: "usersGroup", title: "加入社区", desc: "理科迷拥有完善的QQ社群体系，涵盖年级分群、学科分群、兴趣社团等数十个群组。", href: langUrl(lang, "/communities"), action: "查看全部社群" },
  { icon: "heartHandshake", title: "合作建议", desc: "如果你有科普内容合作、活动联办、技术支持等方面的合作意向，欢迎通过留言表单联系我们。" },
  { icon: "bug", title: "问题反馈", desc: "网站或社区的 Bug 反馈与功能建议，都可以通过留言表单提交，我们会认真处理每一条反馈。" },
  { icon: "mail", title: "邮箱", desc: "almafox123@outlook.com", href: "mailto:almafox123@outlook.com" },
  { icon: "github", title: "GitHub", desc: "github.com/LKM-AHZ", href: "https://github.com/LKM-AHZ", external: true },
  // 官方 B 站账号地址尚未归档，先不做链接：此前 external:true 却指到本站首页，
  // 会以「外链新开标签」的形态把用户带回同一站点，误导性更强
  { icon: "brandBilibili", title: "B站", desc: "关注官方B站账号获取最新科普视频" },
];
---

<OfficialLayout
  title={t(lang, "contact.title")}
  description={t(lang, "seo.contact")}
  currentPath="/contact"
>
  {/* HeroText */}
  <section class="section-padding">
    <div class="container-x">
      <div class="py-8 text-center md:py-12">
        <h1 class="font-heading text-[40px] font-semibold leading-[1.07] tracking-[-0.005em] text-deep-text md:text-[56px]">
          {t(lang, "contact.hero_title")}
        </h1>
      </div>
    </div>
  </section>

  {/* 留言表单 */}
  <section class="section-panel section-padding scroll-mt-[var(--nav-h)]">
    <div class="container-x">
      <div class="mb-14 text-center">
        <h2 class="title-underline font-heading text-3xl font-semibold tracking-[-0.005em] text-deep-text md:text-[40px]">
          {t(lang, "contact.section_message")}
        </h2>
        <p class="mt-8 text-[17px] text-text-muted">
          {t(lang, "contact.section_message_sub")}
        </p>
      </div>

      {/* 不设 method/action：静态站没有接收端，脚本未执行时浏览器只会把字段 GET 回当前 URL */}
      <form id="contact-form" class="card-hover mx-auto flex w-full max-w-xl flex-col rounded-2xl p-4 sm:p-6 lg:p-8">
        <div class="mb-4">
          <label for="contact-name" class="block mb-2 text-sm font-medium text-deep-text">{t(lang, "contact.label_name")}</label>
          <input id="contact-name" name="name" type="text" required class="w-full rounded-[var(--radius-field)] border border-[var(--card-edge)] bg-[var(--ghost-bg)] px-4 py-2.5 text-sm text-base-content transition outline-none focus:border-[var(--primary)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--primary)_25%,transparent)]" />
        </div>
        <div class="mb-4">
          <label for="contact-email" class="block mb-2 text-sm font-medium text-deep-text">{t(lang, "contact.label_email")}</label>
          <input id="contact-email" name="email" type="email" required class="w-full rounded-[var(--radius-field)] border border-[var(--card-edge)] bg-[var(--ghost-bg)] px-4 py-2.5 text-sm text-base-content transition outline-none focus:border-[var(--primary)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--primary)_25%,transparent)]" />
        </div>
        <div class="mb-4">
          <label for="contact-message" class="block mb-2 text-sm font-medium text-deep-text">{t(lang, "contact.label_message")}</label>
          <textarea id="contact-message" name="message" rows="5" required class="w-full rounded-[var(--radius-field)] border border-[var(--card-edge)] bg-[var(--ghost-bg)] px-4 py-2.5 text-sm text-base-content transition outline-none focus:border-[var(--primary)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--primary)_25%,transparent)]"></textarea>
        </div>
        <label class="mb-4 flex items-start gap-2 text-xs text-text-muted cursor-pointer">
          <input type="checkbox" name="agreed" class="mt-0.5 accent-[var(--primary)]" />
          <span>{t(lang, "contact.consent_text")}</span>
        </label>
        <button type="submit" class="btn btn-primary pointer-events-auto">{t(lang, "contact.submit")}</button>
        <p id="form-message" class="mt-3 text-sm text-text-muted text-center"></p>
        <p class="mt-2 text-xs text-text-muted text-center leading-relaxed">{t(lang, "contact.reply_note")}</p>
      </form>
    </div>
  </section>

  {/* 联系方式 */}
  <section class="section-panel section-padding scroll-mt-[var(--nav-h)]">
    <div class="container-x">
      <div class="mb-14 text-center">
        <h2 class="title-underline font-heading text-3xl font-semibold tracking-[-0.005em] text-deep-text md:text-[40px]">
          {t(lang, "contact.section_contact")}
        </h2>
      </div>

      <div class="grid mx-auto gap-5 md:gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          contactItems.map((c) => (
            c.href ? (
              <a href={c.href} target={c.external ? "_blank" : undefined} rel={c.external ? "noopener" : undefined} class="card-hover flex flex-col rounded-2xl p-6 no-underline">
                <Icon name={c.icon} class="mb-6 w-12 h-12 text-primary" />
                <h3 class="text-[17px] font-semibold text-deep-text leading-snug">{c.title}</h3>
                <p class="mt-2 text-[14px] text-text-muted leading-relaxed">{c.desc}</p>
                {c.action && (
                  <span class="mt-4 inline-flex items-center gap-1 text-sm text-primary font-medium">
                    {c.action}
                    <Icon name="arrowRight" class="w-4 h-4 inline-block" />
                  </span>
                )}
              </a>
            ) : (
              <div class="card-hover flex flex-col rounded-2xl p-6 no-underline">
                <Icon name={c.icon} class="mb-6 w-12 h-12 text-primary" />
                <h3 class="text-[17px] font-semibold text-deep-text leading-snug">{c.title}</h3>
                <p class="mt-2 text-[14px] text-text-muted leading-relaxed">{c.desc}</p>
              </div>
            )
          ))
        }
      </div>
    </div>
  </section>
</OfficialLayout>

<script>
  // 静态展示表单：不提交，提示后还原
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const msg = document.getElementById("form-message");
    if (!form || !msg) return;
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      msg.textContent = "此表单为静态展示，暂不支持在线提交。请通过其他方式联系我们。";
      msg.classList.add("!text-red-500");
      setTimeout(() => {
        msg.textContent = "";
        msg.classList.remove("!text-red-500");
      }, 4000);
    });
  });
</script>
