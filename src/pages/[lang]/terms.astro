---
import OfficialLayout from "../../layouts/OfficialLayout.astro";
import { t } from "../../i18n/index";

const lang = (Astro.currentLocale ?? "zh") as string;

import { getStaticPathsForLang } from "../../i18n/paths";
export const getStaticPaths = getStaticPathsForLang;

const copy =
  lang === "en"
    ? {
        intro:
          "Please read these terms before using the LiKeMi (LKM) static website.",
        natureTitle: "Nature of the service",
        nature:
          "This website publishes informational pages, community introductions, announcements, and external links. It does not provide user accounts, payments, cloud storage, or a server-side messaging service.",
        formTitle: "Contact form",
        form: "The contact form is a visual demonstration. Submitting it does not send or retain the entered data. Use one of the listed external contact channels if you need to reach us.",
        availabilityTitle: "Availability and accuracy",
        availability:
          "The website is provided as available. We work to keep content accurate and accessible, but do not guarantee uninterrupted availability or that every historical or external reference remains current.",
        linksTitle: "External services",
        links:
          "Third-party links are provided for convenience. Their content, availability, terms, and data practices are controlled by their respective operators.",
        rightsTitle: "Content and source code",
        rights:
          "Unless otherwise stated, website content belongs to LKM or is used with permission. Source code and third-party materials remain subject to the licenses and notices published with them; those licenses take precedence over this summary.",
        conductTitle: "Acceptable use",
        conduct:
          "Do not attempt to disrupt the website, bypass security controls, misrepresent LKM, or use site content in a way that violates applicable law or another party's rights.",
        changesTitle: "Changes to these terms",
        changes:
          "We may update these terms when the website changes. The latest version and update date will remain available on this page.",
        contactTitle: "Contact",
        contact:
          "Questions about these terms may be sent to almafox123@outlook.com.",
      }
    : {
        intro: "使用理科迷（LKM）静态官网前，请阅读以下条款。",
        natureTitle: "服务性质",
        nature:
          "本站用于发布介绍性页面、社区信息、公告和外部链接，不提供用户账户、在线支付、云端存储或服务器端留言服务。",
        formTitle: "联系表单",
        form: "联系表单仅用于界面展示，提交操作不会发送或保存填写的数据。如需联系我们，请使用页面列出的外部联系渠道。",
        availabilityTitle: "可用性与准确性",
        availability:
          "本站按实际可用状态提供。我们会尽力保持内容准确和页面可访问，但不保证服务持续不中断，也不保证所有历史信息或外部链接始终有效。",
        linksTitle: "第三方服务",
        links:
          "第三方链接仅为访问便利而提供，其内容、可用性、使用条款和数据处理方式由相应运营方负责。",
        rightsTitle: "内容与源代码",
        rights:
          "除另有说明外，本站内容归 LKM 所有或已获授权使用。源代码及第三方材料适用其随附的许可证和声明；若本段摘要与许可证不一致，以许可证为准。",
        conductTitle: "合理使用",
        conduct:
          "不得干扰网站运行、绕过安全控制、冒用 LKM 名义，或以违反适用法律及他人权利的方式使用本站内容。",
        changesTitle: "条款变更",
        changes:
          "网站发生变化时，我们可能修订本条款。最新版本及更新日期会保留在本页面。",
        contactTitle: "联系我们",
        contact: "如对本条款有疑问，请发送邮件至 almafox123@outlook.com。",
      };
---

<OfficialLayout
  title={t(lang, "terms.title")}
  description={t(lang, "seo.terms")}
  currentPath="/terms"
>
  <section class="section-panel section-padding">
    <article class="prose mx-auto max-w-3xl">
      <h1 class="mb-2">{t(lang, "terms.title")}</h1>
      <p class="text-sm text-text-muted !mt-0">
        <em>{t(lang, "terms.updated")}</em>
      </p>

      <p>{copy.intro}</p>

      <h2>{copy.natureTitle}</h2>
      <p>{copy.nature}</p>

      <h2>{copy.formTitle}</h2>
      <p>{copy.form}</p>

      <h2>{copy.availabilityTitle}</h2>
      <p>{copy.availability}</p>

      <h2>{copy.linksTitle}</h2>
      <p>{copy.links}</p>

      <h2>{copy.rightsTitle}</h2>
      <p>{copy.rights}</p>

      <h2>{copy.conductTitle}</h2>
      <p>{copy.conduct}</p>

      <h2>{copy.changesTitle}</h2>
      <p>{copy.changes}</p>

      <h2>{copy.contactTitle}</h2>
      <p>{copy.contact}</p>
    </article>
  </section>
</OfficialLayout>
