---
import OfficialLayout from "../../layouts/OfficialLayout.astro";
import { t } from "../../i18n/index";

const lang = (Astro.currentLocale ?? "zh") as string;

import { getStaticPathsForLang } from "../../i18n/paths";
export const getStaticPaths = getStaticPathsForLang;

// 提醒：本文件的政策正文一旦修改，必须同步更新 i18n 的 privacy.updated
// （zh.ts / en.ts 两份都要改）——页面展示的「最后更新」日期来自那里，不在这里自动跟随。

const copy =
  lang === "en"
    ? {
        intro:
          "This policy explains how information is handled when you visit the LiKeMi (LKM) static website.",
        scopeTitle: "Information handled by this website",
        scope:
          "This website does not provide user accounts, online payments, or server-side form submission. The contact form is a visual demonstration: with JavaScript enabled it only shows a local notice and does not send the name, email address, or message you enter to any server.",
        localTitle: "Local browser storage",
        local:
          "The site stores only your day/night theme preference in localStorage on your device. You can remove it at any time by clearing this site's browser data.",
        hostingTitle: "Hosting and access logs",
        hosting:
          "The hosting provider and network infrastructure may process technical access data such as an IP address, request time, requested path, and user agent for delivery, reliability, and security. Their own privacy terms govern that processing.",
        linksTitle: "External links and contact",
        links:
          "Links may take you to third-party services. If you contact us by email or another external channel, that service will process the information you choose to send under its own privacy policy.",
        childrenTitle: "Children's privacy",
        children:
          "This static website does not intentionally collect children's personal information. A parent or guardian who believes personal information was sent through an external contact channel may contact us to request assistance.",
        changesTitle: "Changes to this policy",
        changes:
          "We may revise this policy when the website or its hosting arrangement changes. The latest version and update date will remain available on this page.",
        contactTitle: "Contact",
        contact:
          "Questions about this policy may be sent to almafox123@outlook.com.",
      }
    : {
        intro:
          "本政策说明您访问理科迷（LKM）静态官网时，相关信息会如何被处理。",
        scopeTitle: "本站处理的信息",
        scope:
          "本站不提供用户账户、在线支付或服务器端表单提交。联系表单仅用于界面展示：在浏览器启用 JavaScript 时，它只在本地给出提示，不会把您填写的姓名、邮箱或留言内容发送给任何服务器。",
        localTitle: "浏览器本地存储",
        local:
          "本站仅使用 localStorage 在您的设备上保存日间或夜间主题偏好。您可以随时通过清除本站浏览器数据将其删除。",
        hostingTitle: "托管与访问日志",
        hosting:
          "网站托管方及网络基础设施可能为内容分发、稳定性和安全目的处理 IP 地址、请求时间、访问路径和 User-Agent 等技术访问数据；相关处理以对应服务方的隐私条款为准。",
        linksTitle: "外部链接与联系渠道",
        links:
          "本站可能链接至第三方服务。若您通过电子邮件或其他外部渠道联系我们，您主动发送的信息将由相应服务按其隐私政策处理。",
        childrenTitle: "儿童隐私",
        children:
          "本站不会主动收集儿童个人信息。如监护人认为个人信息已通过外部联系渠道发送，可联系我们协助处理。",
        changesTitle: "政策变更",
        changes:
          "当网站功能或托管方式发生变化时，我们可能修订本政策。最新版本及更新日期会保留在本页面。",
        contactTitle: "联系我们",
        contact: "如对本政策有疑问，请发送邮件至 almafox123@outlook.com。",
      };
---

<OfficialLayout
  title={t(lang, "privacy.title")}
  description={t(lang, "seo.privacy")}
  currentPath="/privacy"
>
  <section class="section-panel section-padding">
    <article class="prose mx-auto max-w-3xl">
      <h1 class="mb-2">{t(lang, "privacy.title")}</h1>
      <p class="text-sm text-text-muted !mt-0">
        <em>{t(lang, "privacy.updated")}</em>
      </p>

      <p>{copy.intro}</p>

      <h2>{copy.scopeTitle}</h2>
      <p>{copy.scope}</p>

      <h2>{copy.localTitle}</h2>
      <p>{copy.local}</p>

      <h2>{copy.hostingTitle}</h2>
      <p>{copy.hosting}</p>

      <h2>{copy.linksTitle}</h2>
      <p>{copy.links}</p>

      <h2>{copy.childrenTitle}</h2>
      <p>{copy.children}</p>

      <h2>{copy.changesTitle}</h2>
      <p>{copy.changes}</p>

      <h2>{copy.contactTitle}</h2>
      <p>{copy.contact}</p>
    </article>
  </section>
</OfficialLayout>
