---
import OfficialLayout from "../../layouts/OfficialLayout.astro";
import { t } from "../../i18n/index";

const lang = (Astro.currentLocale ?? "zh") as string;

import { getStaticPathsForLang } from "../../i18n/paths";
export const getStaticPaths = getStaticPathsForLang;

// ===== 项目大厅索引页（复刻主应用 /official/projects，硬编码示例项目 + t() 结构标签）=====

const projects = [
  {
    name: "量子计算模拟平台",
    initiator: "七月O 发起",
    status: "recruiting",
    progress: 40,
    pinned: true,
    incubated: true,
    roles: ["前端开发", "UI 设计师"],
  },
  {
    name: "理科迷知识图谱",
    initiator: "七月墨染 发起",
    status: "recruiting",
    progress: 20,
    pinned: false,
    incubated: false,
    roles: ["后端开发", "内容编辑"],
  },
  {
    name: "科普视频系列制作",
    initiator: "七月花 发起",
    status: "showcase",
    progress: 50,
    pinned: false,
    incubated: true,
    roles: [],
  },
  {
    name: "天体观测数据可视化项目",
    initiator: "七月郁离 发起",
    status: "showcase",
    progress: 75,
    pinned: false,
    incubated: false,
    roles: [],
  },
];
---

<OfficialLayout
  title={t(lang, "projects.title")}
  description={t(lang, "seo.projects")}
  currentPath="/projects"
>
  <section class="section-padding">
    <div class="container-x">
      <div class="space-y-6">
        <div class="mb-14 text-center">
          <h1 class="title-underline text-3xl font-bold text-deep-text">
            {t(lang, "projects.title")}
          </h1>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            projects.map((p) => (
              // 项目详情页尚不存在，整卡不做链接：此前每张卡都指向 /communities，
              // 点开跳社群大厅与卡片内容无关，误导性比「不可点」更强
              <div class="profile-card block">
                <div class="profile-inner p-5 flex flex-col gap-3">
                  <div class="flex items-center gap-2 flex-wrap">
                    <h2 class="text-lg font-semibold text-deep-text">
                      {p.name}
                    </h2>
                    {p.pinned && (
                      <span class="text-[10px] px-2 py-0.5 rounded-full bg-primary/15 text-primary font-medium">
                        {t(lang, "projects.pinned")}
                      </span>
                    )}
                    {p.incubated && (
                      <span class="text-[10px] px-2 py-0.5 rounded-full bg-warning/15 text-warning font-medium">
                        {t(lang, "projects.incubated")}
                      </span>
                    )}
                  </div>

                  <div class="flex items-center justify-between gap-2">
                    <span class="text-xs text-text-muted">{p.initiator}</span>
                    <span
                      class:list={[
                        "text-xs px-2 py-0.5 rounded-full font-medium",
                        p.status === "recruiting"
                          ? "bg-success/15 text-success"
                          : "bg-text-muted/15 text-text-muted",
                      ]}
                    >
                      {t(
                        lang,
                        p.status === "recruiting"
                          ? "projects.status_recruiting"
                          : "projects.status_showcase",
                      )}
                    </span>
                  </div>

                  <div>
                    <div class="flex items-center justify-between text-xs text-text-muted mb-1">
                      <span>{t(lang, "projects.progress")}</span>
                      <span>{p.progress}%</span>
                    </div>
                    {/* 进度条此前只有视觉呈现：补上 progressbar 语义，读屏才能读出百分比 */}
                    <div
                      class="h-1.5 rounded-full bg-surface-3 overflow-hidden"
                      role="progressbar"
                      aria-label={t(lang, "projects.progress")}
                      aria-valuenow={p.progress}
                      aria-valuemin={0}
                      aria-valuemax={100}
                    >
                      <div
                        class="h-full rounded-full bg-primary"
                        style={`width: ${p.progress}%`}
                      ></div>
                    </div>
                  </div>

                  {p.roles.length > 0 && (
                    <div class="flex items-center gap-1.5 flex-wrap">
                      {p.roles.map((r) => (
                        // 标签与角色名之间用 flex gap 分隔，不依赖 i18n 值里的尾随空格
                        // （空格会被格式化/编辑器保存时裁掉，裁掉后英文会粘成 Wanted:Developer）
                        <span class="inline-flex items-center gap-1 rounded-full border border-[var(--ghost-edge)] bg-[var(--ghost-bg)] px-2 py-0.5 text-[11px] text-text-muted">
                          {t(lang, "projects.role_missing")}
                          <span>{r}</span>
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</OfficialLayout>
