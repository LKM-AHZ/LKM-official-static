---
import OfficialLayout from "../../layouts/OfficialLayout.astro";
import Icon from "../../components/Icon.astro";
import { t } from "../../i18n/index";
import type { TranslationKey } from "../../i18n/index";
import { getStaticPathsForLang, langUrl } from "../../i18n/paths";
import {
  productCategories,
  products,
  type LocalizedText,
  type ProductCategoryId,
  type ProductItem,
  type ProductStatus,
  type ProductType,
} from "../../data/products";

const lang = (Astro.currentLocale ?? "zh") as string;
const en = lang === "en";

export const getStaticPaths = getStaticPathsForLang;

const localized = (text: LocalizedText): string => (en ? text.en : text.zh);
const localizedFeatures = (p: ProductItem): string[] =>
  en ? p.features.en : p.features.zh;
const typeLabel = (type: ProductType): string =>
  t(lang, `products.type_${type}` as TranslationKey);
const statusLabel = (status: ProductStatus): string =>
  t(lang, `products.status_${status}` as TranslationKey);
const statusClass = (status: ProductStatus): string => {
  switch (status) {
    case "live":
      return "bg-success/15 text-success";
    case "recruiting":
      return "bg-warning/15 text-warning";
    case "preparing":
      return "bg-text-muted/15 text-text-muted";
    default:
      return "bg-primary/15 text-primary";
  }
};
const categoryCount = (id: ProductCategoryId): number =>
  products.filter((p) => p.category === id).length;
const countTemplate = t(lang, "products.showing");
---

<OfficialLayout
  title={t(lang, "products.title")}
  description={t(lang, "seo.products")}
  currentPath="/products"
>
  <section class="section-padding">
    <div class="container-x">
      <header class="mb-12 text-center">
        <h1 class="title-underline font-heading text-section font-bold text-deep-text">
          {t(lang, "products.title")}
        </h1>
        <p class="mx-auto mt-8 max-w-2xl text-lead text-text-muted">
          {t(lang, "products.subtitle")}
        </p>
      </header>

      {/* 分类是整页的简单筛选，不属于任何单张卡片 */}
      <div
        data-product-filterbar
        role="group"
        aria-label={t(lang, "products.filter_aria")}
        class="mx-auto flex max-w-4xl flex-wrap items-center justify-center gap-2"
      >
        <button
          type="button"
          data-product-filter=""
          aria-pressed="true"
          class="inline-flex items-center gap-1.5 rounded-full border border-[var(--card-edge)] bg-[var(--social-bg)] px-3 py-1 text-xs text-text-muted transition hover:border-[var(--primary)] hover:text-primary aria-pressed:border-[var(--primary)] aria-pressed:bg-[var(--social-hover-bg)] aria-pressed:font-medium aria-pressed:text-primary"
        >
          {t(lang, "products.all")}
          <span class="text-[11px] opacity-70">{products.length}</span>
        </button>
        {productCategories.map((cat) => (
          <button
            type="button"
            data-product-filter={cat.id}
            aria-pressed="false"
            class="inline-flex items-center gap-1.5 rounded-full border border-[var(--card-edge)] bg-[var(--social-bg)] px-3 py-1 text-xs text-text-muted transition hover:border-[var(--primary)] hover:text-primary aria-pressed:border-[var(--primary)] aria-pressed:bg-[var(--social-hover-bg)] aria-pressed:font-medium aria-pressed:text-primary"
          >
            {localized(cat.name)}
            <span class="text-[11px] opacity-70">{categoryCount(cat.id)}</span>
          </button>
        ))}
      </div>

      <p
        data-product-count
        data-count-template={countTemplate}
        aria-live="polite"
        class="mb-10 mt-6 text-center text-sm text-text-muted"
      >
        {countTemplate.replace("{n}", String(products.length))}
      </p>

      <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
        {products.map((p) => (
          <article
            data-product-card
            data-category={p.category}
            class="card-hover flex h-full flex-col rounded-2xl p-6"
          >
            <div class="flex items-start justify-between gap-3">
              <span
                class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[var(--icon-bubble-edge)] bg-[var(--icon-bubble-bg)] text-primary"
                aria-hidden="true"
              >
                <Icon name={p.icon} class="h-5 w-5" />
              </span>
              <div class="flex flex-wrap justify-end gap-1.5">
                <span class="inline-flex items-center rounded-full border border-[var(--card-edge)] bg-[var(--social-bg)] px-2 py-0.5 text-[11px] font-medium text-primary">
                  {typeLabel(p.type)}
                </span>
                <span
                  class:list={[
                    "inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium",
                    statusClass(p.status),
                  ]}
                >
                  {statusLabel(p.status)}
                </span>
              </div>
            </div>

            <h2 class="mt-5 text-lg font-bold leading-snug text-deep-text">
              {localized(p.name)}
            </h2>
            <p class="mt-2 text-note text-text-muted">{localized(p.summary)}</p>

            <p class="mt-5 text-[11px] font-semibold uppercase tracking-[0.12em] text-text-muted">
              {t(lang, "products.features_title")}
            </p>
            <ul class="mt-2 space-y-1.5">
              {localizedFeatures(p).map((feature) => (
                <li class="flex items-start gap-2 text-sm leading-relaxed text-text-muted">
                  <Icon
                    name="chevronRight"
                    class="mt-0.5 h-4 w-4 shrink-0 text-primary"
                  />
                  <span>{feature}</span>
                </li>
              ))}
            </ul>

            {p.href && (
              <a
                href={langUrl(lang, p.href)}
                class="mt-auto inline-flex items-center gap-1 pt-6 text-sm font-medium text-primary no-underline transition hover:underline"
              >
                {p.linkLabel
                  ? localized(p.linkLabel)
                  : t(lang, "products.view")}
                <Icon name="arrowRight" class="h-4 w-4" />
              </a>
            )}
          </article>
        ))}
      </div>

      <p
        data-product-empty
        hidden
        class="mt-5 rounded-2xl border border-[var(--card-edge)] bg-[var(--social-bg)] px-6 py-10 text-center text-sm text-text-muted"
      >
        {t(lang, "products.empty")}
      </p>
    </div>
  </section>

  <section class="section-padding pt-0">
    <div class="container-x">
      <div class="card-hover mx-auto max-w-3xl rounded-2xl p-8 text-center">
        <h2 class="text-section font-semibold mb-3 font-heading">
          {t(lang, "products.cta_title")}
        </h2>
        <p class="text-body text-text-muted">{t(lang, "products.cta_body")}</p>
        <div class="mt-6 flex justify-center">
          <a href={langUrl(lang, "/about#communities")} class="btn btn-primary">
            {t(lang, "products.cta_button")}
            <Icon name="arrowRight" class="h-5 w-5" />
          </a>
        </div>
      </div>
    </div>
  </section>
</OfficialLayout>

<script>
  const buttons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-product-filter]"),
  );
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>("[data-product-card]"),
  );
  const count = document.querySelector<HTMLElement>("[data-product-count]");
  const empty = document.querySelector<HTMLElement>("[data-product-empty]");

  if (buttons.length > 0 && cards.length > 0) {
    const valid = new Set(
      buttons.map((btn) => btn.dataset.productFilter ?? ""),
    );
    const fromUrl = new URLSearchParams(location.search).get("category") ?? "";
    const initial = valid.has(fromUrl) ? fromUrl : "";

    const apply = (category: string): void => {
      let shown = 0;
      for (const card of cards) {
        const hit = category === "" || card.dataset.category === category;
        card.hidden = !hit;
        if (hit) shown += 1;
      }

      for (const btn of buttons) {
        btn.setAttribute(
          "aria-pressed",
          String((btn.dataset.productFilter ?? "") === category),
        );
      }
      if (count) {
        count.textContent = (count.dataset.countTemplate ?? "{n}").replace(
          "{n}",
          String(shown),
        );
      }
      if (empty) empty.hidden = shown > 0;

      const url = new URL(location.href);
      if (category) url.searchParams.set("category", category);
      else url.searchParams.delete("category");
      history.replaceState(null, "", url);
    };

    for (const btn of buttons) {
      btn.addEventListener("click", () =>
        apply(btn.dataset.productFilter ?? ""),
      );
    }
    apply(initial);
  }
</script>

<style is:global>
  /* 卡片根元素带 flex，作者样式的 display 会盖过 UA 的 [hidden] */
  [data-product-card][hidden] {
    display: none;
  }
</style>
