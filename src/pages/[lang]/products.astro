---
import OfficialLayout from "../../layouts/OfficialLayout.astro";
import Icon from "../../components/Icon.astro";
import { t } from "../../i18n/index";
import type { TranslationKey } from "../../i18n/index";
import { getStaticPathsForLang, langUrl } from "../../i18n/paths";
import {
  productCategories,
  products,
  type LocalizedText,
  type ProductItem,
  type ProductStatus,
  type ProductType,
} from "../../data/products";

const lang = (Astro.currentLocale ?? "zh") as string;
const en = lang === "en";

export const getStaticPaths = getStaticPathsForLang;

const localized = (text: LocalizedText): string => (en ? text.en : text.zh);
const localizedFeatures = (p: ProductItem): string[] =>
  en ? p.features.en : p.features.zh;
const typeLabel = (type: ProductType): string =>
  t(lang, `products.type_${type}` as TranslationKey);
const statusLabel = (status: ProductStatus): string =>
  t(lang, `products.status_${status}` as TranslationKey);
const statusClass = (status: ProductStatus): string => {
  switch (status) {
    case "live":
      return "bg-success/15 text-success";
    case "recruiting":
      return "bg-warning/15 text-warning";
    case "preparing":
    case "ended":
      return "bg-text-muted/15 text-text-muted";
    default:
      return "bg-primary/15 text-primary";
  }
};

/**
 * 项目/工作室的状态筛选：把「已上线」并入「进行中」。
 * 产品单独使用「未上线 / 已上线」两档，见 productStatusFor。
 */
const statusFilterId = (
  status: ProductStatus,
): Exclude<ProductStatus, "live"> => (status === "live" ? "ongoing" : status);

const projectStatusDefs: { id: string; label: string }[] = [
  { id: "preparing", label: t(lang, "products.status_preparing") },
  { id: "recruiting", label: t(lang, "products.status_recruiting") },
  { id: "ongoing", label: t(lang, "products.status_ongoing") },
  { id: "ended", label: t(lang, "products.status_ended") },
];

const productStatusDefs: { id: string; label: string }[] = [
  { id: "offline", label: t(lang, "products.status_offline") },
  { id: "live", label: t(lang, "products.status_live") },
];

const productStatusFor = (p: ProductItem): "live" | "offline" =>
  p.status === "live" ? "live" : "offline";

const projectItems = products.filter((p) => p.type === "project");
const studioItems = products.filter((p) => p.type === "studio");
const productItems = products.filter((p) => p.type === "product");

interface ProductTag {
  id: string;
  label: string;
  count: number;
}

const projectTags: ProductTag[] = productCategories.map((cat) => ({
  id: cat.id,
  label: localized(cat.name),
  count: projectItems.filter((p) => p.category === cat.id).length,
}));

const studioTags: ProductTag[] = [
  {
    id: "tech",
    label: t(lang, "products.studio_focus_tech"),
    count: studioItems.filter((p) => p.studioFocus === "tech").length,
  },
  {
    id: "education",
    label: t(lang, "products.studio_focus_education"),
    count: studioItems.filter((p) => p.studioFocus === "education").length,
  },
];

const productTags: ProductTag[] = [
  {
    id: "online",
    label: t(lang, "products.kind_online"),
    count: productItems.filter((p) => p.productKind === "online").length,
  },
];

interface ProductView {
  key: "project" | "studio" | "product";
  title: string;
  items: ProductItem[];
  tags: ProductTag[];
  tagFor: (p: ProductItem) => string;
  statusDefs: { id: string; label: string }[];
  statusFor: (p: ProductItem) => string;
}

const views: ProductView[] = [
  {
    key: "project",
    title: t(lang, "products.type_project"),
    items: projectItems,
    tags: projectTags,
    tagFor: (p) => p.category,
    statusDefs: projectStatusDefs,
    statusFor: (p) => statusFilterId(p.status),
  },
  {
    key: "studio",
    title: t(lang, "products.type_studio"),
    items: studioItems,
    tags: studioTags,
    tagFor: (p) => p.studioFocus ?? "",
    statusDefs: projectStatusDefs,
    statusFor: (p) => statusFilterId(p.status),
  },
  {
    key: "product",
    title: t(lang, "products.type_product"),
    items: productItems,
    tags: productTags,
    tagFor: (p) => p.productKind ?? "",
    statusDefs: productStatusDefs,
    statusFor: productStatusFor,
  },
];

const countTemplate = t(lang, "products.showing");
const filterChipClass =
  "inline-flex items-center gap-1.5 rounded-full border border-[var(--card-edge)] bg-[var(--social-bg)] px-3 py-1 text-xs text-text-muted transition hover:border-[var(--primary)] hover:text-primary aria-pressed:border-[var(--primary)] aria-pressed:bg-[var(--social-hover-bg)] aria-pressed:font-medium aria-pressed:text-primary";
---

<OfficialLayout
  title={t(lang, "products.title")}
  description={t(lang, "seo.products")}
  currentPath="/products"
>
  <section class="section-padding">
    <div class="container-x">
      <header class="mb-12 text-center">
        <h1 class="title-underline font-heading text-section font-bold text-deep-text">
          {t(lang, "products.title")}
        </h1>
        <p class="mx-auto mt-8 max-w-2xl text-lead text-text-muted">
          {t(lang, "products.subtitle")}
        </p>
      </header>

      {/* 项目 / 工作室 / 产品 三类内容左右切换 */}
      <div class="mx-auto w-full max-w-4xl">
        <div
          role="tablist"
          aria-label={t(lang, "products.tabs_aria")}
          class="flex items-center justify-center gap-8 border-b border-[var(--card-edge)]"
        >
          {views.map((view, index) => (
            <button
              type="button"
              role="tab"
              id={`${view.key}-tab`}
              data-product-tab={view.key}
              aria-selected={index === 0 ? "true" : "false"}
              aria-controls={`${view.key}-panel`}
              tabindex={index === 0 ? 0 : -1}
              class="-mb-px border-b-2 border-transparent px-1 pb-3 text-lg font-semibold text-text-muted transition-colors hover:text-deep-text aria-selected:border-[var(--primary)] aria-selected:text-deep-text"
            >
              {view.title}
            </button>
          ))}
        </div>
      </div>

      <div class="mt-2">
        {views.map((view, index) => (
          <div
            id={`${view.key}-panel`}
            role="tabpanel"
            aria-labelledby={`${view.key}-tab`}
            data-product-panel={view.key}
            hidden={index > 0}
          >
            <div
              data-product-tagbar
              role="group"
              aria-label={t(lang, "products.filter_aria")}
              class="mx-auto mt-6 flex max-w-4xl flex-wrap items-center justify-center gap-2"
            >
              <button
                type="button"
                data-product-tag=""
                aria-pressed="true"
                class={filterChipClass}
              >
                {t(lang, "products.all")}
                <span class="text-[11px] opacity-70">{view.items.length}</span>
              </button>
              {view.tags.map((tag) => (
                <button
                  type="button"
                  data-product-tag={tag.id}
                  aria-pressed="false"
                  class={filterChipClass}
                >
                  {tag.label}
                  <span class="text-[11px] opacity-70">{tag.count}</span>
                </button>
              ))}
            </div>

            <div
              role="group"
              aria-label={t(lang, "products.status_filter_aria")}
              class="mx-auto mt-3 flex max-w-4xl flex-wrap items-center justify-center gap-2"
            >
              <span class="text-xs text-text-muted">
                {t(lang, "products.status_label")}
              </span>
              <button
                type="button"
                data-product-status=""
                aria-pressed="true"
                class={filterChipClass}
              >
                {t(lang, "products.all")}
                <span class="text-[11px] opacity-70">{view.items.length}</span>
              </button>
              {view.statusDefs.map((status) => (
                <button
                  type="button"
                  data-product-status={status.id}
                  aria-pressed="false"
                  class={filterChipClass}
                >
                  {status.label}
                  <span class="text-[11px] opacity-70">
                    {
                      view.items.filter((p) => view.statusFor(p) === status.id)
                        .length
                    }
                  </span>
                </button>
              ))}
            </div>

            <p
              data-product-count
              data-count-template={countTemplate}
              aria-live="polite"
              class="mb-10 mt-6 text-center text-sm text-text-muted"
            >
              {countTemplate.replace("{n}", String(view.items.length))}
            </p>

            <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
              {view.items.map((p) => (
                <article
                  data-product-card
                  data-category={view.tagFor(p)}
                  data-status={view.statusFor(p)}
                  class="card-hover flex h-full flex-col rounded-2xl p-6"
                >
                  <div class="flex items-start justify-between gap-3">
                    <span
                      class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[var(--icon-bubble-edge)] bg-[var(--icon-bubble-bg)] text-primary"
                      aria-hidden="true"
                    >
                      <Icon name={p.icon} class="h-5 w-5" />
                    </span>
                    <div class="flex flex-wrap justify-end gap-1.5">
                      <span class="inline-flex items-center rounded-full border border-[var(--card-edge)] bg-[var(--social-bg)] px-2 py-0.5 text-[11px] font-medium text-primary">
                        {typeLabel(p.type)}
                      </span>
                      <span
                        class:list={[
                          "inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium",
                          statusClass(p.status),
                        ]}
                      >
                        {statusLabel(p.status)}
                      </span>
                    </div>
                  </div>

                  <h2 class="mt-5 text-lg font-bold leading-snug text-deep-text">
                    {localized(p.name)}
                  </h2>
                  <p class="mt-2 text-note text-text-muted">
                    {localized(p.summary)}
                  </p>

                  <p class="mt-5 text-[11px] font-semibold uppercase tracking-[0.12em] text-text-muted">
                    {t(lang, "products.features_title")}
                  </p>
                  <ul class="mt-2 space-y-1.5">
                    {localizedFeatures(p).map((feature) => (
                      <li class="flex items-start gap-2 text-sm leading-relaxed text-text-muted">
                        <Icon
                          name="chevronRight"
                          class="mt-0.5 h-4 w-4 shrink-0 text-primary"
                        />
                        <span>{feature}</span>
                      </li>
                    ))}
                  </ul>

                  {p.href && (
                    <a
                      href={langUrl(lang, p.href)}
                      class="mt-auto inline-flex items-center gap-1 pt-6 text-sm font-medium text-primary no-underline transition hover:underline"
                    >
                      {p.linkLabel
                        ? localized(p.linkLabel)
                        : t(lang, "products.view")}
                      <Icon name="arrowRight" class="h-4 w-4" />
                    </a>
                  )}
                </article>
              ))}
            </div>

            <p
              data-product-empty
              hidden
              class="mt-5 rounded-2xl border border-[var(--card-edge)] bg-[var(--social-bg)] px-6 py-10 text-center text-sm text-text-muted"
            >
              {t(lang, "products.empty")}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding pt-0">
    <div class="container-x">
      <div class="card-hover mx-auto max-w-3xl rounded-2xl p-8 text-center">
        <h2 class="text-section font-semibold mb-3 font-heading">
          {t(lang, "products.cta_title")}
        </h2>
        <p class="text-body text-text-muted">{t(lang, "products.cta_body")}</p>
        <div class="mt-6 flex justify-center">
          <a href={langUrl(lang, "/about#communities")} class="btn btn-primary">
            {t(lang, "products.cta_button")}
            <Icon name="arrowRight" class="h-5 w-5" />
          </a>
        </div>
      </div>
    </div>
  </section>
</OfficialLayout>

<script>
  const tabButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-product-tab]"),
  );

  interface PanelState {
    key: string;
    panel: HTMLElement;
    cards: HTMLElement[];
    tagButtons: HTMLButtonElement[];
    statusButtons: HTMLButtonElement[];
    count: HTMLElement | null;
    empty: HTMLElement | null;
    activeTag: string;
    activeStatus: string;
  }

  const panels: PanelState[] = Array.from(
    document.querySelectorAll<HTMLElement>("[data-product-panel]"),
  ).map((panel) => ({
    key: panel.dataset.productPanel ?? "",
    panel,
    cards: Array.from(
      panel.querySelectorAll<HTMLElement>("[data-product-card]"),
    ),
    tagButtons: Array.from(
      panel.querySelectorAll<HTMLButtonElement>("[data-product-tag]"),
    ),
    statusButtons: Array.from(
      panel.querySelectorAll<HTMLButtonElement>("[data-product-status]"),
    ),
    count: panel.querySelector<HTMLElement>("[data-product-count]"),
    empty: panel.querySelector<HTMLElement>("[data-product-empty]"),
    activeTag: "",
    activeStatus: "",
  }));

  if (tabButtons.length > 0 && panels.length > 0) {
    const defaultView = tabButtons[0]?.dataset.productTab ?? panels[0].key;
    let activeView = defaultView;

    const syncButtons = (
      buttons: HTMLButtonElement[],
      active: string,
      key: "productTag" | "productStatus",
    ): void => {
      for (const btn of buttons) {
        btn.setAttribute(
          "aria-pressed",
          String((btn.dataset[key] ?? "") === active),
        );
      }
    };

    const applyPanel = (state: PanelState): void => {
      let shown = 0;
      for (const card of state.cards) {
        const tagHit =
          state.activeTag === "" || card.dataset.category === state.activeTag;
        const statusHit =
          state.activeStatus === "" ||
          card.dataset.status === state.activeStatus;
        const hit = tagHit && statusHit;
        card.hidden = !hit;
        if (hit) shown += 1;
      }

      if (state.count) {
        state.count.textContent = (
          state.count.dataset.countTemplate ?? "{n}"
        ).replace("{n}", String(shown));
      }
      if (state.empty) state.empty.hidden = shown > 0;
    };

    const applyAll = (): void => {
      for (const state of panels) applyPanel(state);
    };

    const updateUrl = (): void => {
      const url = new URL(location.href);
      if (activeView === defaultView) url.searchParams.delete("tab");
      else url.searchParams.set("tab", activeView);

      const current = panels.find((state) => state.key === activeView);
      if (current?.activeTag)
        url.searchParams.set("category", current.activeTag);
      else url.searchParams.delete("category");
      if (current?.activeStatus)
        url.searchParams.set("status", current.activeStatus);
      else url.searchParams.delete("status");

      history.replaceState(null, "", url);
    };

    const showTab = (
      view: string,
      clearFilters = false,
      moveFocus = false,
    ): void => {
      const target = tabButtons.find((tab) => tab.dataset.productTab === view);
      if (!target) return;

      const changed = view !== activeView;
      activeView = view;
      for (const tab of tabButtons) {
        const selected = tab === target;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
      }
      for (const state of panels) {
        state.panel.hidden = state.key !== view;
      }

      if (clearFilters && changed) {
        for (const state of panels) {
          state.activeTag = "";
          state.activeStatus = "";
          syncButtons(state.tagButtons, "", "productTag");
          syncButtons(state.statusButtons, "", "productStatus");
        }
        applyAll();
      }

      updateUrl();
      if (moveFocus) target.focus();
    };

    for (const tab of tabButtons) {
      tab.addEventListener("click", () =>
        showTab(tab.dataset.productTab ?? "", true),
      );
      tab.addEventListener("keydown", (event) => {
        if (
          event.key !== "ArrowLeft" &&
          event.key !== "ArrowRight" &&
          event.key !== "Home" &&
          event.key !== "End"
        ) {
          return;
        }
        event.preventDefault();
        const index = tabButtons.indexOf(tab);
        const nextIndex =
          event.key === "ArrowLeft"
            ? (index - 1 + tabButtons.length) % tabButtons.length
            : event.key === "ArrowRight"
              ? (index + 1) % tabButtons.length
              : event.key === "Home"
                ? 0
                : tabButtons.length - 1;
        const next = tabButtons[nextIndex];
        showTab(next.dataset.productTab ?? "", true, true);
      });
    }

    for (const state of panels) {
      for (const btn of state.tagButtons) {
        btn.addEventListener("click", () => {
          state.activeTag = btn.dataset.productTag ?? "";
          syncButtons(state.tagButtons, state.activeTag, "productTag");
          applyPanel(state);
          updateUrl();
        });
      }
      for (const btn of state.statusButtons) {
        btn.addEventListener("click", () => {
          state.activeStatus = btn.dataset.productStatus ?? "";
          syncButtons(state.statusButtons, state.activeStatus, "productStatus");
          applyPanel(state);
          updateUrl();
        });
      }
    }

    // 初始状态：?tab= 切换分类，?category= / ?status= 恢复标签与状态筛选
    const params = new URLSearchParams(location.search);
    const requestedView = params.get("tab") ?? "";
    const initialView = tabButtons.some(
      (tab) => tab.dataset.productTab === requestedView,
    )
      ? requestedView
      : defaultView;
    const initialPanel = panels.find((state) => state.key === initialView);

    const requestedTag = params.get("category") ?? "";
    const requestedStatus = params.get("status") ?? "";
    if (initialPanel) {
      if (
        initialPanel.tagButtons.some(
          (btn) => (btn.dataset.productTag ?? "") === requestedTag,
        ) &&
        requestedTag !== ""
      ) {
        initialPanel.activeTag = requestedTag;
      }
      if (
        initialPanel.statusButtons.some(
          (btn) => (btn.dataset.productStatus ?? "") === requestedStatus,
        ) &&
        requestedStatus !== ""
      ) {
        initialPanel.activeStatus = requestedStatus;
      }
      syncButtons(
        initialPanel.tagButtons,
        initialPanel.activeTag,
        "productTag",
      );
      syncButtons(
        initialPanel.statusButtons,
        initialPanel.activeStatus,
        "productStatus",
      );
    }

    showTab(initialView);
    applyAll();
  }
</script>

<style is:global>
  /* 卡片根元素带 flex，作者样式的 display 会盖过 UA 的 [hidden] */
  [data-product-card][hidden] {
    display: none;
  }
</style>
