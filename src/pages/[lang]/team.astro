---
import OfficialSidebarLayout from "../../layouts/OfficialSidebarLayout.astro";
import MemberCard from "../../components/MemberCard.astro";
import DepartmentSection from "../../components/DepartmentSection.astro";
import { teamData as zhTeam } from "../../data/team-data";
import { teamData as enTeam } from "../../data/en/team-data";
import { pickByLocale, t } from "../../i18n/index";
import type { MemberLists, SubGroupMaps, TeamData } from "../../data/team-types";

const lang = (Astro.currentLocale ?? "zh") as string;

import { getStaticPathsForLang } from "../../i18n/paths";
export const getStaticPaths = getStaticPathsForLang;

// ===== 团队页 =====
const team = pickByLocale<TeamData>(lang, zhTeam, enTeam);

const sidebarItems = [
  { text: t(lang, "team.sidebar_founder"), href: "#founder", icon: "star" },
  { text: t(lang, "team.sidebar_general"), href: "#general", icon: "buildingSkyscraper" },
  { text: t(lang, "team.sidebar_affairs"), href: "#affairs", icon: "users" },
  { text: t(lang, "team.sidebar_events"), href: "#events", icon: "calendarEvent" },
  { text: t(lang, "team.sidebar_news"), href: "#news", icon: "news" },
  { text: t(lang, "team.sidebar_advisors"), href: "#advisors", icon: "userCheck" },
  { text: t(lang, "team.sidebar_professional"), href: "#professional", icon: "certificate" },
  { text: t(lang, "team.sidebar_tech"), href: "#tech", icon: "code" },
  { text: t(lang, "team.sidebar_alumni"), href: "#alumni", icon: "userX" },
];

const ml: MemberLists = team.memberLists;
const sg: SubGroupMaps = team.subGroupMaps;
---

<OfficialSidebarLayout
  title={t(lang, "team.title")}
  description={t(lang, "seo.team")}
  currentPath="/team"
  sidebarItems={sidebarItems}
>
  {/* 创始人 */}
  <section id="founder" class="relative not-prose scroll-mt-[72px]">
    <div class="relative mx-auto max-w-7xl px-4 md:px-6 py-16 md:py-20 lg:py-24">
      <h2 class="text-xl font-bold mb-2 text-center">
        <span class="border-b-2 border-primary pb-1">{t(lang, "team.founder_title")}</span>
      </h2>
      <p class="mt-3 text-[17px] text-text-muted text-center mb-9 leading-relaxed">
        {t(lang, "team.founder_subtitle")}
      </p>
      <div class="max-w-2xl mx-auto">
        {
          ml.founderMembers?.map((m) => (
            <MemberCard
              name={m.name ?? ""}
              avatarKey={m.avatarKey}
              role={m.role}
              desc={m.desc}
              dream={m.dream}
              quote={m.quote}
              size="lg"
            />
          ))
        }
      </div>
    </div>
  </section>

  {/* 总务部 */}
  <DepartmentSection
    id="general"
    title={t(lang, "team.general_title")}
    borderColor="#ef4444"
    desc={t(lang, "team.general_desc")}
  >
    {
      ml.generalMembers?.map((m) => (
        <MemberCard
          name={m.name ?? ""}
          avatarKey={m.avatarKey}
          role={m.role}
          desc={m.desc}
          dream={m.dream}
          quote={m.quote}
        />
      ))
    }
  </DepartmentSection>

  {/* 群务部 */}
  <DepartmentSection
    id="affairs"
    title={t(lang, "team.affairs_title")}
    borderColor="#3b82f6"
    desc={t(lang, "team.affairs_desc")}
    noGrid
  >
    {
      Object.entries(sg.affairsSubGroups ?? {}).map(([, group]) => (
        <div class="mb-12">
          <h3 class="text-md font-bold mb-3 text-center text-text-muted">
            {group.label}
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {group.members?.map((m) => (
              <MemberCard
                name={m.name ?? ""}
                avatarKey={m.avatarKey}
                role={m.role}
                desc={m.desc}
                dream={m.dream}
                quote={m.quote}
                level={4}
              />
            ))}
          </div>
        </div>
      ))
    }
  </DepartmentSection>

  {/* 活动策划部 */}
  <DepartmentSection
    id="events"
    title={t(lang, "team.events_title")}
    borderColor="#f97316"
    desc={t(lang, "team.events_desc")}
  >
    {
      ml.eventsMembers?.map((m) => (
        <MemberCard
          name={m.name ?? ""}
          avatarKey={m.avatarKey}
          role={m.role}
          desc={m.desc}
          dream={m.dream}
          quote={m.quote}
        />
      ))
    }
  </DepartmentSection>

  {/* 新闻办 */}
  <DepartmentSection
    id="news"
    title={t(lang, "team.news_title")}
    borderColor="#22c55e"
    desc={t(lang, "team.news_desc")}
    noGrid
  >
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        ml.newsMembers?.map((m) => (
          <MemberCard
            name={m.name ?? ""}
            avatarKey={m.avatarKey}
            role={m.role}
            desc={m.desc}
            dream={m.dream}
            quote={m.quote}
          />
        ))
      }
    </div>
    {
      Object.entries(sg.newsSubGroups ?? {}).map(([, group]) => (
        <div class="mt-8">
          <h3 class="text-md font-bold mb-3 text-center text-text-muted">
            {group.label}
          </h3>
          {group.desc && (
            <p class="max-w-3xl mx-auto mb-6 px-6 py-3 bg-page-bg border border-surface-3 rounded-[8px] text-center text-[13px] text-text-muted leading-relaxed">
              {group.desc}
            </p>
          )}
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {group.members?.map((m) => (
              <MemberCard
                name={m.name ?? ""}
                avatarKey={m.avatarKey}
                role={m.role}
                desc={m.desc}
                dream={m.dream}
                quote={m.quote}
                level={4}
              />
            ))}
          </div>
        </div>
      ))
    }
  </DepartmentSection>

  {/* 顾问团 */}
  <DepartmentSection
    id="advisors"
    title={t(lang, "team.advisors_title")}
    borderColor="#eab308"
    desc={t(lang, "team.advisors_desc")}
  >
    {
      ml.advisorMembers?.map((m) => (
        <MemberCard
          name={m.name ?? ""}
          avatarKey={m.avatarKey}
          role={m.role}
          desc={m.desc}
          dream={m.dream}
          quote={m.quote}
        />
      ))
    }
  </DepartmentSection>

  {/* 专业委员会 */}
  <DepartmentSection
    id="professional"
    title={t(lang, "team.professional_title")}
    borderColor="#a855f7"
    desc={t(lang, "team.professional_desc")}
    noGrid
  >
    {
      Object.entries(sg.professionalSubGroups ?? {}).map(([, group]) => (
        <div class="mb-12">
          <h3 class="text-md font-bold mb-3 text-center text-text-muted">
            {group.label}
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {group.members?.map((m) => (
              <MemberCard
                name={m.name ?? ""}
                avatarKey={m.avatarKey}
                role={m.role}
                desc={m.desc}
                dream={m.dream}
                quote={m.quote}
                level={4}
              />
            ))}
          </div>
        </div>
      ))
    }
  </DepartmentSection>

  {/* 技术委员会 */}
  <DepartmentSection
    id="tech"
    title={t(lang, "team.tech_title")}
    borderColor="#6b7280"
    desc={t(lang, "team.tech_desc")}
  >
    {
      ml.techMembers?.map((m) => (
        <MemberCard
          name={m.name ?? ""}
          avatarKey={m.avatarKey}
          role={m.role}
          desc={m.desc}
          dream={m.dream}
          quote={m.quote}
        />
      ))
    }
  </DepartmentSection>

  {/* 已离开成员 */}
  <section id="alumni" class="relative not-prose scroll-mt-[72px]">
    <div class="relative mx-auto max-w-7xl px-4 md:px-6 py-16 md:py-20 lg:py-24">
      <h2 class="text-xl font-bold mb-9 text-center">
        <span class="border-b-2 border-surface-3 pb-1">{t(lang, "team.alumni_title")}</span>
      </h2>
      <p class="max-w-3xl mx-auto mb-9 px-6 py-4 bg-page-bg border border-surface-3 rounded-[8px] text-center text-[14px] text-text-muted leading-relaxed">
        {t(lang, "team.alumni_desc")}
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          ml.alumniMembers?.map((m) => (
            <MemberCard
              name={m.name ?? ""}
              avatarKey={m.avatarKey}
              role={m.role}
              desc={m.desc}
              dream={m.dream}
              quote={m.quote}
            />
          ))
        }
      </div>
    </div>
  </section>
</OfficialSidebarLayout>
