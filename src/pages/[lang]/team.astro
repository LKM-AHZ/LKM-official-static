---
import OfficialSidebarLayout from "../../layouts/OfficialSidebarLayout.astro";
import MemberCard from "../../components/MemberCard.astro";
import DepartmentSection from "../../components/DepartmentSection.astro";
import { teamData as zhTeam } from "../../data/team-data";
import { teamData as enTeam } from "../../data/en/team-data";
import { pickByLocale, t } from "../../i18n/index";
import type {
  MemberLists,
  SubGroupMaps,
  TeamData,
} from "../../data/team-types";

const lang = (Astro.currentLocale ?? "zh") as string;

import { getStaticPathsForLang } from "../../i18n/paths";
export const getStaticPaths = getStaticPathsForLang;

// ===== 团队页 =====
const team = pickByLocale<TeamData>(lang, zhTeam, enTeam);

const sidebarItems = [
  { text: t(lang, "team.sidebar_founder"), href: "#founder", icon: "star" },
  {
    text: t(lang, "team.sidebar_general"),
    href: "#general",
    icon: "buildingSkyscraper",
  },
  { text: t(lang, "team.sidebar_affairs"), href: "#affairs", icon: "users" },
  {
    text: t(lang, "team.sidebar_events"),
    href: "#events",
    icon: "calendarEvent",
  },
  { text: t(lang, "team.sidebar_news"), href: "#news", icon: "news" },
  {
    text: t(lang, "team.sidebar_advisors"),
    href: "#advisors",
    icon: "userCheck",
  },
  {
    text: t(lang, "team.sidebar_professional"),
    href: "#professional",
    icon: "certificate",
  },
  { text: t(lang, "team.sidebar_tech"), href: "#tech", icon: "code" },
  { text: t(lang, "team.sidebar_project"), href: "#project", icon: "rocket" },
  { text: t(lang, "team.sidebar_alumni"), href: "#alumni", icon: "userX" },
];

const ml: MemberLists = team.memberLists;
const sg: SubGroupMaps = team.subGroupMaps;
---

<OfficialSidebarLayout
  title={t(lang, "team.title")}
  description={t(lang, "seo.team")}
  currentPath="/team"
  sidebarItems={sidebarItems}
>
  {/* 创始人 */}
  <section
    id="founder"
    class="section-panel section-padding scroll-mt-[var(--nav-h)]"
  >
    <div class="container-x">
      <h2 class="mb-14 text-center">
        <span
          class="title-underline font-heading text-xl font-bold text-deep-text"
        >
          {t(lang, "team.founder_title")}
        </span>
      </h2>
      <p class="mb-9 text-center text-[17px] leading-relaxed text-text-muted">
        {t(lang, "team.founder_subtitle")}
      </p>
      <div class="max-w-2xl mx-auto">
        {
          ml.founderMembers.map((m) => (
            <MemberCard
              name={m.name ?? ""}
              avatarKey={m.avatarKey}
              role={m.role}
              desc={m.desc}
              dream={m.dream}
              quote={m.quote}
              size="lg"
            />
          ))
        }
      </div>
    </div>
  </section>

  {/* 总务部 */}
  <DepartmentSection
    id="general"
    title={t(lang, "team.general_title")}
    desc={t(lang, "team.general_desc")}
  >
    {
      ml.generalMembers.map((m) => (
        <MemberCard
          name={m.name ?? ""}
          avatarKey={m.avatarKey}
          role={m.role}
          desc={m.desc}
          dream={m.dream}
          quote={m.quote}
        />
      ))
    }
  </DepartmentSection>

  {/* 群务部 */}
  <DepartmentSection
    id="affairs"
    title={t(lang, "team.affairs_title")}
    desc={t(lang, "team.affairs_desc")}
    noGrid
  >
    {
      Object.entries(sg.affairsSubGroups ?? {}).map(([, group]) => (
        <div class="mb-12">
          <h3 class="text-md font-bold mb-3 text-center text-deep-text">
            {group.label}
          </h3>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {group.members?.map((m) => (
              <MemberCard
                name={m.name ?? ""}
                avatarKey={m.avatarKey}
                role={m.role}
                desc={m.desc}
                dream={m.dream}
                quote={m.quote}
                level={4}
              />
            ))}
          </div>
        </div>
      ))
    }
  </DepartmentSection>

  {/* 活动策划部 */}
  <DepartmentSection
    id="events"
    title={t(lang, "team.events_title")}
    desc={t(lang, "team.events_desc")}
  >
    {
      ml.eventsMembers.map((m) => (
        <MemberCard
          name={m.name ?? ""}
          avatarKey={m.avatarKey}
          role={m.role}
          desc={m.desc}
          dream={m.dream}
          quote={m.quote}
        />
      ))
    }
  </DepartmentSection>

  {/* 新闻办 */}
  <DepartmentSection
    id="news"
    title={t(lang, "team.news_title")}
    desc={t(lang, "team.news_desc")}
    noGrid
  >
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        ml.newsMembers.map((m) => (
          <MemberCard
            name={m.name ?? ""}
            avatarKey={m.avatarKey}
            role={m.role}
            desc={m.desc}
            dream={m.dream}
            quote={m.quote}
          />
        ))
      }
    </div>
    {
      Object.entries(sg.newsSubGroups ?? {}).map(([, group]) => (
        <div class="mt-8">
          <h3 class="text-md font-bold mb-3 text-center text-deep-text">
            {group.label}
          </h3>
          {group.desc && (
            <p class="card-hover max-w-3xl mx-auto mb-6 px-6 py-3 rounded-2xl text-center text-[13px] text-text-muted leading-relaxed">
              {group.desc}
            </p>
          )}
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {group.members?.map((m) => (
              <MemberCard
                name={m.name ?? ""}
                avatarKey={m.avatarKey}
                role={m.role}
                desc={m.desc}
                dream={m.dream}
                quote={m.quote}
                level={4}
              />
            ))}
          </div>
        </div>
      ))
    }
  </DepartmentSection>

  {/* 顾问团 */}
  <DepartmentSection
    id="advisors"
    title={t(lang, "team.advisors_title")}
    desc={t(lang, "team.advisors_desc")}
  >
    {
      ml.advisorMembers.map((m) => (
        <MemberCard
          name={m.name ?? ""}
          avatarKey={m.avatarKey}
          role={m.role}
          desc={m.desc}
          dream={m.dream}
          quote={m.quote}
        />
      ))
    }
  </DepartmentSection>

  {/* 专业委员会 */}
  <DepartmentSection
    id="professional"
    title={t(lang, "team.professional_title")}
    desc={t(lang, "team.professional_desc")}
    noGrid
  >
    {
      Object.entries(sg.professionalSubGroups ?? {}).map(([, group]) => (
        <div class="mb-12">
          <h3 class="text-md font-bold mb-3 text-center text-deep-text">
            {group.label}
          </h3>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {group.members?.map((m) => (
              <MemberCard
                name={m.name ?? ""}
                avatarKey={m.avatarKey}
                role={m.role}
                desc={m.desc}
                dream={m.dream}
                quote={m.quote}
                level={4}
              />
            ))}
          </div>
        </div>
      ))
    }
  </DepartmentSection>

  {/* 技术委员会 */}
  <DepartmentSection
    id="tech"
    title={t(lang, "team.tech_title")}
    desc={t(lang, "team.tech_desc")}
  >
    {
      ml.techMembers.map((m) => (
        <MemberCard
          name={m.name ?? ""}
          avatarKey={m.avatarKey}
          role={m.role}
          desc={m.desc}
          dream={m.dream}
          quote={m.quote}
        />
      ))
    }
  </DepartmentSection>

  {/* 项目团队 */}
  <DepartmentSection
    id="project"
    title={t(lang, "team.project_title")}
    desc={t(lang, "team.project_desc")}
    noGrid
  >
    {
      Object.entries(sg.projectSubGroups ?? {}).map(([, group]) => (
        <div class="mb-12">
          <h3 class="text-md font-bold mb-3 text-center text-deep-text">
            {group.label}
          </h3>
          {group.desc && (
            <p class="mx-auto mb-6 max-w-3xl text-center text-[14px] leading-relaxed text-text-muted">
              {group.desc}
            </p>
          )}
          {group.members?.length ? (
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {group.members.map((m) => (
                <MemberCard
                  name={m.name ?? ""}
                  avatarKey={m.avatarKey}
                  role={m.role}
                  desc={m.desc}
                  dream={m.dream}
                  quote={m.quote}
                  level={4}
                />
              ))}
            </div>
          ) : (
            <p class="text-center text-sm text-text-muted">
              {t(lang, "team.subgroup_empty")}
            </p>
          )}
        </div>
      ))
    }
  </DepartmentSection>

  {/* 已离开成员 */}
  <section
    id="alumni"
    class="section-panel section-padding scroll-mt-[var(--nav-h)]"
  >
    <div class="container-x">
      <h2 class="mb-14 text-center">
        <span
          class="title-underline font-heading text-xl font-bold text-deep-text"
        >
          {t(lang, "team.alumni_title")}
        </span>
      </h2>
      <p
        class="card-hover mx-auto mb-9 max-w-3xl rounded-2xl px-6 py-4 text-center text-[14px] leading-relaxed text-text-muted"
      >
        {t(lang, "team.alumni_desc")}
      </p>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          ml.alumniMembers.map((m) => (
            <MemberCard
              name={m.name ?? ""}
              avatarKey={m.avatarKey}
              role={m.role}
              desc={m.desc}
              dream={m.dream}
              quote={m.quote}
            />
          ))
        }
      </div>
    </div>
  </section>
</OfficialSidebarLayout>
