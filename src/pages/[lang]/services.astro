---
// 服务内容已并入「关于」页（/about）。此页仅做老链路跳转，避免旧书签/入口 404。
const lang = (Astro.currentLocale ?? "zh") as string;

import { getStaticPathsForLang } from "../../i18n/paths";
export const getStaticPaths = getStaticPathsForLang;

const dest = lang === "en" ? "/en/about/" : "/zh/about/";
const title = lang === "en" ? "Services — merged" : "服务 —— 已合并至关于";
const site = Astro.site ?? new URL("https://lkm-ahz.icu");
const canonical = new URL(dest, site).href;
---

<!doctype html>
<html lang={lang === "en" ? "en" : "zh-CN"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonical} />
    {/* 属性值必须用模板字符串插值：引号里写 {dest} 会被 Astro 当字面量原样输出，跳转失效 */}
    <meta http-equiv="refresh" content={`0; url=${dest}`} />
  </head>
  <body>
    <p><a href={dest}>{lang === "en" ? "Services now live inside About — jump there" : "服务内容已并入「关于」页 — 正在前往"}</a></p>
  </body>
</html>
