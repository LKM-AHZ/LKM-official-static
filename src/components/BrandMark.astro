---
/**
 * 品牌标识：六边形 + 三条椭圆轨道的原子图形。
 * 描边/填充全部走主题 token，故 day / night 自动换色，且可多处复用
 * （不使用 <linearGradient>，避免同一页面出现重复 id）。
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 38, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  aria-hidden="true"
  class={className}
>
  <path
    d="M24 3 42 13.5v21L24 45 6 34.5v-21L24 3Z"
    stroke="var(--primary)"
    stroke-width="2"
    fill="color-mix(in srgb, var(--primary) 10%, transparent)"></path>
  <circle cx="24" cy="24" r="4.2" fill="var(--primary)"></circle>
  <ellipse
    cx="24"
    cy="24"
    rx="15"
    ry="6"
    stroke="var(--primary)"
    stroke-width="1.3"
    opacity=".8"></ellipse>
  <ellipse
    cx="24"
    cy="24"
    rx="15"
    ry="6"
    stroke="var(--secondary)"
    stroke-width="1.3"
    opacity=".6"
    transform="rotate(60 24 24)"></ellipse>
  <ellipse
    cx="24"
    cy="24"
    rx="15"
    ry="6"
    stroke="var(--primary)"
    stroke-width="1.3"
    opacity=".6"
    transform="rotate(120 24 24)"></ellipse>
</svg>
