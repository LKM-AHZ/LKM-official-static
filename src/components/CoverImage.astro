---
/**
 * 带降级路径的封面图。
 *
 * 加载策略：
 * - 本地封面在构建期补充 400w / 600w WebP，复用现有 800w / 1200w 文件；
 *   浏览器按布局宽度与 DPR 选择，避免小卡片下载大图。
 * - 缩略图 404/损坏时先回退到主图；主图也失败才隐藏 img，露出父容器的
 *   标题渐变占位，避免页面上出现破图图标。
 * - 尺寸属性始终显式给出，配合 CSS 的固定高度避免 CLS。
 */
import { publicUrl } from "../lib/assets";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: string;
  alt: string;
  /** 同源 800w 缩略图；缺省或与 src 相同时只加载 src */
  thumb?: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  /** srcset 生效时的布局宽度提示 */
  sizes?: string;
}

const {
  src,
  alt,
  thumb,
  width = 1200,
  height = 650,
  class: className,
  loading = "lazy",
  fetchpriority,
  sizes = "100vw",
} = Astro.props;

// public/ 下的图片必须带部署前缀，否则子路径部署（GitHub Pages 项目页）会 404
const mainSrc = publicUrl(src);
const thumbSrc = thumb && thumb !== src ? publicUrl(thumb) : undefined;
// 只在构建期处理原图；原有 public 文件继续作为加载失败时的降级路径。
const covers = import.meta.glob<{ default: ImageMetadata }>([
  "/public/images/covers/*.webp",
  "!/public/images/covers/*-800w.webp",
]);
const localImage = thumbSrc ? covers[`/public${src}`] : undefined;
const optimized = localImage
  ? await getImage({
      src: localImage(),
      width: 400,
      widths: [400, 600],
      format: "webp",
    })
  : undefined;
const srcset = thumbSrc
  ? `${optimized ? `${optimized.srcSet.attribute}, ` : ""}${thumbSrc} 800w, ${mainSrc} 1200w`
  : undefined;

// 第一次失败回退到主图，第二次失败隐藏自身：父容器已铺好标题渐变，
// 隐藏后该区域仍是完整色块而不是浏览器默认的破图图标。
const onError =
  "if(this.dataset.fallbackSrc){this.removeAttribute('srcset');this.src=this.dataset.fallbackSrc;this.removeAttribute('data-fallback-src')}else{this.style.display='none'}";
---

<img
  src={optimized?.src ?? thumbSrc ?? mainSrc}
  srcset={srcset}
  sizes={srcset ? (loading === "lazy" ? `auto, ${sizes}` : sizes) : undefined}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  fetchpriority={fetchpriority}
  decoding="async"
  class={className}
  data-fallback-src={thumbSrc ? mainSrc : undefined}
  onerror={onError}
/>
