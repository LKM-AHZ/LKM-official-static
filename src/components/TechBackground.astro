---
/**
 * 全站动态背景（简朴 · 科技感）
 *
 * - WebGL2：一个全屏 pass 画三团呼吸辉光，points 画节点，instanced quad 画连线
 * - 滚动视差：滚轮/滑动产生带深度差的下沉、上升冲量
 * - 三团呼吸辉光 + 鼠标轻微视差，辉光随滚动进度对冲迁移
 * - day / night 两套调色板，跟随 <html data-theme>
 * - 底色/网格/极光/暗角/噪点仍由 tech.css 的静态层承担：它们每帧不重绘，
 *   是合成器缓存层，也是 WebGL2 不可用/只有软件光栅化时的兜底
 * - 减少动态效果/省流量/2G 使用 CSS；空闲时加载，最多 200 万像素，后台暂停
 * - 30fps + 时间步长：背景是慢动画，没必要占满 60/120Hz
 *
 * 移植自「理科迷官网-源代码」的 TechBackground.vue，后改为 WebGL2。
 */
---

<canvas id="tech-canvas" aria-hidden="true"></canvas>
<!-- 与 canvas 同为 z-index 1 且排在它之后：暗角/噪点也盖住粒子，四角收得更干净 -->
<div class="bg-overlay" aria-hidden="true"></div>

<script>
  const canvas = document.getElementById(
    "tech-canvas",
  ) as HTMLCanvasElement | null;
  const force = new URLSearchParams(location.search).get("bg");
  const connection = (
    navigator as Navigator & {
      connection?: { saveData?: boolean; effectiveType?: string };
    }
  ).connection;
  const constrained =
    window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
    connection?.saveData ||
    /^(slow-)?2g$/.test(connection?.effectiveType ?? "");

  if (force === "css" || (force !== "webgl" && constrained)) {
    canvas?.remove();
  } else if (canvas) {
    // 首屏、字体与交互就绪后才下载并编译装饰性 WebGL 着色器。
    const load = async (): Promise<void> => {
      if (document.hidden) {
        document.addEventListener(
          "visibilitychange",
          () => {
            void load();
          },
          { once: true },
        );
        return;
      }
      try {
        const { startTechBackground } = await import("../lib/tech-background");
        startTechBackground(canvas);
      } catch {
        canvas.remove();
      }
    };
    const schedule = (): void => {
      if ("requestIdleCallback" in window) {
        window.requestIdleCallback(
          () => {
            void load();
          },
          { timeout: 2000 },
        );
      } else {
        setTimeout(() => {
          void load();
        }, 200);
      }
    };
    if (document.readyState === "complete") schedule();
    else window.addEventListener("load", schedule, { once: true });
  }
</script>
