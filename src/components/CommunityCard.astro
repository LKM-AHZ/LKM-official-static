---
import { t } from "../i18n/index";

/**
 * 社群卡：名称 + QQ 群号徽标（点击复制）+ desc。
 */
interface Props {
  name: string;
  qqGroup?: string;
  desc?: string;
  isQQChannel?: boolean;
}

const { name, qqGroup, desc, isQQChannel = false } = Astro.props;
const lang = (Astro.currentLocale ?? "zh") as string;
const copyLabel = `${t(lang, isQQChannel ? "communities.copy_channel" : "communities.copy")} ${qqGroup ?? ""}`.trim();
---

<div class="profile-card">
  <div class="profile-inner p-5 flex flex-col gap-3">
    <div class="flex items-center justify-between gap-2">
      <h3 class="font-bold text-base text-deep-text">{name}</h3>
      {qqGroup && (
        <button
          type="button"
          class="inline-flex items-center gap-1.5 shrink-0 text-xs font-mono bg-surface-3 text-text-muted rounded-[6px] px-2.5 py-1 cursor-pointer select-none hover:bg-primary hover:text-on-primary transition-colors"
          data-copy={qqGroup}
          title={copyLabel}
          aria-label={copyLabel}
        >
          {isQQChannel && "频道 ID："}
          {qqGroup}
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="13" height="13" x="9" y="9" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        </button>
      )}
    </div>
    {desc && <p class="text-xs text-text-muted leading-relaxed">{desc}</p>}
  </div>
</div>

<script>
  // 点击复制群号
  document.addEventListener("click", (e) => {
    const target = (e.target as HTMLElement).closest("[data-copy]");
    if (!target) return;
    const text = target.getAttribute("data-copy");
    if (!text) return;
    navigator.clipboard?.writeText(text)?.then(() => {
      const el = target as HTMLElement;
      const prev = el.title;
      el.title = "已复制！";
      el.classList.add("!bg-success", "!text-on-success");
      setTimeout(() => {
        el.title = prev;
        el.classList.remove("!bg-success", "!text-on-success");
      }, 1500);
    })?.catch(() => {});
  });
</script>
