---
import Icon from "./Icon.astro";
import BrandMark from "./BrandMark.astro";
import ThemeToggle from "./ThemeToggle.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { t } from "../i18n/index";
import type { Lang, TranslationKey } from "../i18n/index";
import { langUrl, stripLangPrefix } from "../i18n/paths";

/**
 * 刘海式顶栏（fixed）：通栏贴顶、仅下缘圆角，形似屏幕刘海。
 * 状态（滚动加深、移动面板开合）与主题切换改由原生脚本驱动。
 */
const lang = (Astro.currentLocale ?? "zh") as Lang;

/** 当前页（已剥离语言前缀），用于导航激活态 */
const currentPath = stripLangPrefix(Astro.url.pathname);

const navLinks: { href: string; key: TranslationKey }[] = [
  { href: "/", key: "common.nav_home" },
  { href: "/news", key: "common.nav_articles" },
  { href: "/about", key: "common.nav_about" },
  { href: "/team", key: "common.nav_team" },
  { href: "/resources", key: "common.nav_resources" },
];

// 首页只在精确匹配时激活（否则任何路径都会点亮它）；其余按路径段前缀匹配，
// 这样 /news/<slug> 之类的子页面也能点亮它的父级导航项
const isActive = (href: string): boolean =>
  href === "/"
    ? currentPath === "/"
    : currentPath === href || currentPath.startsWith(`${href}/`);

const communityHref = langUrl(lang, "/communities");
const communityLabel = t(lang, "common.nav_communities");
const brandLabel = lang === "en" ? "PHIENTIST" : t(lang, "common.brand");
---

<nav
  id="navbar"
  class="fixed inset-x-0 top-0 z-[9999]"
  aria-label={t(lang, "common.aria.main_nav")}
>
  <!-- 顶栏始终占窗口宽度的 90%，移动面板并入同一块玻璃 -->
  <div class="nav-shell mx-auto w-[90vw]" data-nav-shell>
    <div
      class="flex min-h-[68px] w-full items-center justify-between gap-3 px-[3%] lg:gap-2"
    >
      <!-- 双行品牌锁定较窄宽度，给导航与工具区留出呼吸空间 -->
      <div class="flex shrink-0 items-center">
        <a
          href={langUrl(lang, "/")}
          class="nav-brand flex items-center gap-3 rounded-xl no-underline"
          data-nav-home
        >
          <BrandMark size={38} />
          <span
            class="flex flex-col justify-center gap-0.5 text-[19px] font-bold leading-none tracking-wide text-deep-text"
          >
            {brandLabel}
            {
              lang !== "en" && (
                <span class="text-[10px] font-semibold tracking-[0.2em] text-[var(--primary)]">
                  PHIENTIST
                </span>
              )
            }
          </span>
        </a>
      </div>

      <!-- 中段：主导航 -->
      <div class="nav-links hidden items-center lg:flex">
        {
          navLinks.map((l) => (
            <a
              href={langUrl(lang, l.href)}
              class:list={[
                "nav-link group relative rounded-xl px-2 py-2 text-[15px] font-medium no-underline transition-colors xl:px-3",
                isActive(l.href)
                  ? "is-active text-[var(--primary)]"
                  : "text-text-muted hover:text-deep-text",
              ]}
              aria-current={isActive(l.href) ? "page" : undefined}
            >
              {t(lang, l.key)}
              <span class="nav-underline" aria-hidden="true" />
            </a>
          ))
        }
      </div>

      <!-- 右段：主题/语言为一组，细线分隔后接社区入口 -->
      <div
        class="hidden shrink-0 items-center justify-end gap-2 lg:flex xl:gap-3"
      >
        <ThemeToggle />
        <LanguageSwitcher />
        <span class="h-6 w-px bg-[var(--nav-edge)]" aria-hidden="true"></span>
        <a
          href={communityHref}
          class="btn-ghost-pill nav-community"
          aria-label={communityLabel}
        >
          {communityLabel}
          <Icon name="arrowRight" class="w-4 h-4" />
        </a>
      </div>

      <div class="flex items-center gap-2 lg:hidden">
        <ThemeToggle />
        <button
          type="button"
          class="nav-menu-toggle flex h-10 w-10 items-center justify-center rounded-xl text-deep-text"
          aria-label={t(lang, "common.aria.menu")}
          aria-expanded="false"
          aria-controls="nav-mobile-panel"
          data-nav-toggle
        >
          <span data-nav-icon="open" class="flex">
            <Icon name="menu" class="w-[22px] h-[22px]" />
          </span>
          <span data-nav-icon="close" class="hidden">
            <Icon name="close" class="w-[22px] h-[22px]" />
          </span>
        </button>
      </div>
    </div>

    <!-- 移动端菜单：刘海下拉 -->
    <div
      id="nav-mobile-panel"
      class="nav-mobile-panel max-h-0 lg:hidden"
      data-nav-panel
      inert
    >
      <div
        class="nav-mobile-links mx-auto flex w-full max-w-[1184px] flex-col px-4 pt-3 pb-4 sm:px-5"
      >
        {
          navLinks.map((l) => (
            <a
              href={langUrl(lang, l.href)}
              class:list={[
                "rounded-xl px-3 py-2.5 text-base tracking-[0.04em] no-underline transition-colors",
                isActive(l.href)
                  ? "bg-[var(--social-hover-bg)] text-[var(--primary)]"
                  : "text-text-muted hover:text-deep-text",
              ]}
              aria-current={isActive(l.href) ? "page" : undefined}
            >
              {t(lang, l.key)}
            </a>
          ))
        }
        {
          /* 社区入口下方已有 btn-primary 的 CTA，此处不再重复一个同 href 同文案的普通行 */
        }
        <div class="mt-2 flex items-center justify-between px-3">
          <LanguageSwitcher />
          <a href={communityHref} class="btn btn-primary btn-sm">
            {communityLabel}
            <Icon name="arrowRight" class="w-4 h-4" />
          </a>
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  const shell = document.querySelector<HTMLElement>("[data-nav-shell]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-nav-panel]");

  if (shell) {
    const onScroll = (): void => {
      shell.classList.toggle("is-scrolled", window.scrollY > 50);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  if (toggle && panel) {
    const setOpen = (open: boolean): void => {
      panel.style.maxHeight = open ? `${panel.scrollHeight}px` : "0px";
      panel.inert = !open;
      toggle.setAttribute("aria-expanded", String(open));
      toggle
        .querySelector<HTMLElement>('[data-nav-icon="open"]')
        ?.classList.toggle("hidden", open);
      toggle
        .querySelector<HTMLElement>('[data-nav-icon="close"]')
        ?.classList.toggle("hidden", !open);
    };

    toggle.addEventListener("click", () => {
      setOpen(panel.style.maxHeight === "0px" || !panel.style.maxHeight);
    });

    document.addEventListener("click", (event) => {
      const target = event.target as Node;
      if (
        panel.style.maxHeight !== "0px" &&
        !panel.contains(target) &&
        !toggle.contains(target)
      ) {
        setOpen(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && panel.style.maxHeight !== "0px") {
        setOpen(false);
        toggle.focus();
      }
    });

    window.matchMedia("(min-width: 1024px)").addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });

    setOpen(false);
  }

  // 已在首页时点「首页」应平滑回顶，而不是重新加载
  document
    .querySelector<HTMLAnchorElement>("[data-nav-home]")
    ?.addEventListener("click", (event) => {
      const path = window.location.pathname.replace(/^\/(zh|en)(?=\/|$)/, "");
      if (path === "" || path === "/") {
        event.preventDefault();
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    });
</script>
