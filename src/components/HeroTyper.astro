---
import Icon from "./Icon.astro";
import { t } from "../i18n/index";
import type { Lang } from "../i18n/index";

/**
 * 首屏：打字机轮播 + 滚动渐隐。
 *
 * 视觉移植自「理科迷官网-源代码」的 HeroTyper.vue：渐变遮罩 + 打字光标 +
 * 滚动时让首屏内容下沉淡出。
 */
interface Props {
  title: string;
  subtitle: string;
  /** 副标题下方的正文（可省略） */
  lead?: string;
  /** 「了解更多」按钮的目标锚点（不含 #） */
  nextAnchor?: string;
  ctaHref?: string;
  ctaLabel?: string;
}

const lang = (Astro.currentLocale ?? "zh") as Lang;
const {
  title,
  subtitle,
  lead,
  nextAnchor = "resources-entry",
  ctaHref,
  ctaLabel,
} = Astro.props;

const typingTexts = [title, subtitle].filter(Boolean);
---

<header
  id="hero-stage"
  class="relative flex min-h-screen items-center justify-center overflow-hidden"
  data-hero
  data-typing-texts={JSON.stringify(typingTexts)}
  data-hero-anchor={nextAnchor}
>
  <div class="hero-overlay absolute inset-0 z-0"></div>
  <div class="hero-fade pointer-events-none absolute inset-0 z-0"></div>

  <div class="container-x relative z-10 px-4 text-center" data-hero-inner>
    <p
      class="animate-fadeInUp mb-5 text-sm tracking-[.35em] text-[var(--primary)]"
      style="animation-delay:.05s"
    >
      PHIENTIST · SCIENCE COMMUNITY
    </p>
    <h1 class="hero-title text-shadow mb-6 text-display font-bold text-deep-text">
      {/* 隐藏的 sizer 把 title / subtitle 都按同一宽度排版，H1 高度取最长文案；
           打字机切到更长的副标题时不会把下方 CTA 顶下去。 */}
      <span class="hero-title-sizer" aria-hidden="true">
        {typingTexts.map((text) => (
          <span data-sizer-text={text} />
        ))}
      </span>
      <span class="hero-title-live">
        <span data-typing-content>{title}</span>
        <span class="typing-cursor">|</span>
      </span>
    </h1>
    <p
      class="animate-fadeInUp mx-auto mb-4 max-w-2xl text-lead text-text-muted"
      style="animation-delay:.2s"
    >
      {lead}
    </p>
    <p
      class="animate-fadeInUp mx-auto mb-10 text-sm tracking-widest text-text-muted"
      style="animation-delay:.3s"
    >
      SCIENCE · TECHNOLOGY · FUTURE
    </p>
    <div class="animate-fadeInUp" style="animation-delay:.4s">
      {ctaHref ? (
        <a href={ctaHref} class="btn btn-primary btn-lg">
          {ctaLabel ?? t(lang, "home.cta_communities")}
          <Icon name="arrowRight" class="w-5 h-5" />
        </a>
      ) : (
        <button type="button" class="btn btn-primary btn-lg" data-hero-next>
          {t(lang, "home.hero_scroll")}
          <Icon name="arrowDown" class="w-5 h-5" />
        </button>
      )}
    </div>
  </div>

  <div class="bounce-soft absolute bottom-10 left-1/2 z-10 text-2xl text-text-muted">
    <Icon name="chevronDown" class="w-6 h-6" />
  </div>
</header>

<style>
  /* 打字机只改文字、不改 H1 高度：sizer 把全部候选文案叠在同一格里，
     H1 高度取最长文案；切换到更长的副标题时不会把下方内容顶下去。
     contain: layout 把文字重排限制在 H1 内部，避免波及 hero 其余节点。 */
  .hero-title {
    display: grid;
    justify-items: center;
    contain: layout;
  }

  .hero-title-sizer,
  .hero-title-live {
    grid-area: 1 / 1;
    width: 100%;
  }

  /* sizer 按最长文案撑高；当前文案在预留高度里垂直居中，短标题不会贴顶 */
  .hero-title-live {
    align-self: center;
  }

  .hero-title-sizer {
    display: grid;
    visibility: hidden;
    pointer-events: none;
  }

  .hero-title-sizer > span {
    grid-area: 1 / 1;
    width: 100%;
  }

  .hero-title-sizer > span::before {
    content: attr(data-sizer-text);
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const inner = document.querySelector<HTMLElement>("[data-hero-inner]");
  const target = document.querySelector<HTMLElement>("[data-typing-content]");

  if (hero && inner && target) {
    const el = target;
    const reduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const texts: string[] = JSON.parse(hero.dataset.typingTexts ?? "[]");
    let timer = 0;
    let visible = true;
    let paused = false;

    if (reduced || texts.length === 0) {
      el.textContent = texts[0] ?? "";
    } else {
      // SSR 文案先完整显示；700ms 后从“删除”开始，避免首帧 H1 被清空。
      // 这样 LCP 不会因为打字机先清空、再逐字重打而延后。
      let index = 0;
      let char = texts[0].length;
      let deleting = true;
      el.textContent = texts[0];

      function schedule(delay: number): void {
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          timer = 0;
          if (!visible || document.hidden) {
            paused = true;
            return;
          }
          tick();
        }, delay);
      }

      function tick(): void {
        const text = texts[index];
        if (deleting) {
          char -= 1;
          el.textContent = text.slice(0, char);
          if (char <= 0) {
            deleting = false;
            index = (index + 1) % texts.length;
            schedule(600);
            return;
          }
          schedule(45);
        } else {
          char += 1;
          el.textContent = text.slice(0, char);
          if (char >= text.length) {
            deleting = true;
            schedule(2000);
            return;
          }
          schedule(90);
        }
      }

      // Hero 滚出视口或标签页进后台时停掉定时器：文字不再重排，
      // 也避免长页面上一直为一个看不见的标题做 layout。
      if ("IntersectionObserver" in window) {
        new IntersectionObserver(
          (entries) => {
            visible = entries.some((entry) => entry.isIntersecting);
            if (visible && paused) {
              paused = false;
              schedule(600);
            }
          },
          { threshold: 0 },
        ).observe(hero);
      }

      document.addEventListener("visibilitychange", () => {
        if (document.hidden) {
          window.clearTimeout(timer);
          timer = 0;
          paused = true;
        } else if (visible) {
          paused = false;
          schedule(600);
        }
      });

      schedule(700);
    }

    // 首屏随滚动渐隐（背景的滚动响应统一由 TechBackground 写 --scroll-progress）
    const onScroll = (): void => {
      const p = Math.min(window.scrollY / (window.innerHeight * 0.72), 1);
      inner.style.opacity = String(1 - p * 0.55);
      if (!reduced) {
        inner.style.transform = `translateY(${p * -26}px)`;
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  document
    .querySelector<HTMLElement>("[data-hero-next]")
    ?.addEventListener("click", () => {
      const id = hero?.dataset.heroAnchor;
      if (!id) return;
      document.getElementById(id)?.scrollIntoView({ behavior: "smooth" });
    });
</script>
