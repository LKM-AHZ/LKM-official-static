---
import avatarMap from "../data/avatar-map.json";

/**
 * 团队成员卡。
 * avatarKey → avatar-map.json → /images/avatars/tNN.webp；无头像走首字回退。
 */
interface Props {
  name: string;
  avatarKey?: string;
  role?: string;
  desc?: string;
  dream?: string;
  quote?: string;
  size?: "sm" | "lg";
  /** 标题层级：部门直属于 section(h2) 下用 3；子分组(h3)内用 4 */
  level?: 3 | 4;
}

const { name, avatarKey, role, desc, dream, quote, size = "sm", level = 3 } = Astro.props;
const isLg = size === "lg";
const HeadingTag = level === 4 ? "h4" : "h3";

// avatarKey（如 "七月千寻.jpg"）→ 源文件名；avatar-map 存按 key 的映射。
const avatarName = avatarKey
  ? avatarMap[avatarKey as keyof typeof avatarMap]
  : undefined;
const avatarSrc = avatarName ? `/images/avatars/${avatarName}` : undefined;

const fallbackChar = name.replace("七月", "").charAt(0) || name.charAt(0);
const avatarSize = isLg
  ? "w-16 h-16 sm:w-24 sm:h-24"
  : "w-10 h-10 sm:w-16 sm:h-16";
---

<div class="profile-card">
  <div class="profile-inner p-4 sm:p-5 flex flex-row items-center gap-3 sm:flex-col sm:items-center text-left sm:text-center">
    <div class="shrink-0 sm:mb-3">
      {avatarSrc ? (
        <img
          src={avatarSrc}
          alt={name}
          width={192}
          height={192}
          class={`${avatarSize} rounded-full object-cover`}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div
          class={`${avatarSize} rounded-full bg-surface-3 text-text-muted flex items-center justify-center text-lg font-semibold`}
        >
          {fallbackChar}
        </div>
      )}
    </div>
    <div class="flex-1 min-w-0">
      <HeadingTag
        class:list={[
          isLg ? "text-[21px] font-semibold" : "font-bold text-lg",
          "text-deep-text",
        ]}
      >
        {name}
      </HeadingTag>
      {role && (
        <span class={isLg ? "text-primary font-semibold" : "text-xs text-text-muted"}>
          {role}
        </span>
      )}
      {desc && <p class="text-xs text-text-muted mt-1">{desc}</p>}
      {dream && (
        <p class="text-xs text-secondary mt-1 italic">{dream}</p>
      )}
      {quote && (
        <p class="text-xs text-primary mt-1">{quote}</p>
      )}
    </div>
  </div>
</div>
