---
import avatarMap from "../data/avatar-map.json";
import { publicUrl } from "../lib/assets";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

/**
 * 团队成员卡。
 * avatarKey → avatar-map.json → /images/avatars/tNN.webp；无头像走首字回退。
 */
interface Props {
  name: string;
  avatarKey?: string;
  role?: string;
  desc?: string;
  dream?: string;
  quote?: string;
  size?: "sm" | "lg";
  /** 标题层级：部门直属于 section(h2) 下用 3；子分组(h3)内用 4 */
  level?: 3 | 4;
}

const {
  name,
  avatarKey,
  role,
  desc,
  dream,
  quote,
  size = "sm",
  level = 3,
} = Astro.props;
const isLg = size === "lg";
const HeadingTag = level === 4 ? "h4" : "h3";

// avatarKey（如 "七月千寻.jpg"）→ 源文件名；avatar-map 存按 key 的映射。
const avatarName = avatarKey
  ? avatarMap[avatarKey as keyof typeof avatarMap]
  : undefined;
const avatarSrc = avatarName
  ? publicUrl(`/images/avatars/${avatarName}`)
  : undefined;
// 小卡片在手机/桌面显示为 40/64px，大卡片为 64/96px；按 DPR 选图。
// 原始 192px 文件保留给高密度屏及加载失败回退，不改同步脚本生成的文件。
const avatars = import.meta.glob<{ default: ImageMetadata }>(
  "/public/images/avatars/*.webp",
);
const localImage = avatarName
  ? avatars[`/public/images/avatars/${avatarName}`]
  : undefined;
const optimized = localImage
  ? await getImage({
      src: localImage(),
      width: isLg ? 64 : 40,
      widths: isLg ? [64, 96, 128] : [40, 64, 80, 128],
      format: "webp",
    })
  : undefined;

// avatar-map.json 由 scripts/sync-team-avatars.mts 生成，与 team-data.ts 容易漂移；
// 只在开发期提示，避免线上构建因为一个头像文件缺失就中断
if (import.meta.env.DEV && avatarKey && !avatarName) {
  console.warn(
    `[MemberCard] avatarKey "${avatarKey}" 不在 avatar-map.json 中，已回退为首字头像`,
  );
}

// 昵称前的「七月」是团队称呼惯例，作展示用前缀剥掉：必须只匹配开头，
// 否则名字中间含「七月」的成员会被 replace 挖掉中间那两字
const displayName = name.startsWith("七月") ? name.slice(2) : name;
const fallbackChar = displayName.charAt(0) || name.charAt(0);
const avatarSize = isLg
  ? "w-16 h-16 sm:w-24 sm:h-24"
  : "w-10 h-10 sm:w-16 sm:h-16";
---

<div class="profile-card">
  <div class="profile-inner p-4 sm:p-5 flex flex-row items-center gap-3 sm:flex-col sm:items-center text-left sm:text-center">
    <div class="shrink-0 sm:mb-3">
      {avatarSrc ? (
        <img
          src={optimized?.src ?? avatarSrc}
          srcset={
            optimized
              ? `${optimized.srcSet.attribute}, ${avatarSrc} 192w`
              : undefined
          }
          sizes={
            optimized
              ? `auto, (min-width: 640px) ${isLg ? 96 : 64}px, ${isLg ? 64 : 40}px`
              : undefined
          }
          alt=""
          width={192}
          height={192}
          class={`${avatarSize} rounded-full object-cover`}
          loading="lazy"
          decoding="async"
          data-fallback-src={optimized ? avatarSrc : undefined}
          onerror={
            optimized
              ? "this.removeAttribute('onerror');this.removeAttribute('srcset');this.src=this.dataset.fallbackSrc"
              : undefined
          }
        />
      ) : (
        <div
          class={`${avatarSize} rounded-full bg-surface-3 text-text-muted flex items-center justify-center text-lg font-semibold`}
        >
          {fallbackChar}
        </div>
      )}
    </div>
    <div class="flex-1 min-w-0">
      <HeadingTag
        class:list={[
          isLg ? "text-[21px] font-semibold" : "font-bold text-lg",
          "text-deep-text",
        ]}
      >
        {name}
      </HeadingTag>
      {role && (
        <span
          class={
            isLg
              ? "text-primary font-semibold"
              : "text-[0.8125rem] text-text-muted"
          }
        >
          {role}
        </span>
      )}
      {desc && <p class="text-sm text-text-muted mt-1">{desc}</p>}
      {dream && <p class="text-sm text-secondary mt-1 italic">{dream}</p>}
      {quote && <p class="text-sm text-primary mt-1">{quote}</p>}
    </div>
  </div>
</div>
