---
import Icon from "./Icon.astro";
import { t } from "../i18n/index";
import type { Lang } from "../i18n/index";

const lang = (Astro.currentLocale ?? "zh") as Lang;
---

<button
  type="button"
  data-back-top
  aria-label={t(lang, "common.aria.back_to_top")}
  title={t(lang, "common.aria.back_to_top")}
  class="back-top pointer-events-none fixed bottom-8 right-8 z-[9998] flex h-12 w-12 translate-y-20 items-center justify-center rounded-full opacity-0"
>
  <Icon name="chevronUp" class="w-[18px] h-[18px]" />
</button>

<script>
  const btn = document.querySelector<HTMLElement>("[data-back-top]");
  if (btn) {
    const sync = (): void => {
      const visible = window.scrollY > 300;
      btn.classList.toggle("opacity-0", !visible);
      btn.classList.toggle("translate-y-20", !visible);
      btn.classList.toggle("pointer-events-none", !visible);
    };
    window.addEventListener("scroll", sync, { passive: true });
    btn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
    sync();
  }
</script>
