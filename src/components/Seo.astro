---
/**
 * 统一 head 元信息：canonical / Open Graph / Twitter / hreflang / JSON-LD。
 * 由 OfficialLayout 渲染一次；不要在别处重复引入，否则会产生重复标签。
 */
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { SITE_NAME } from "../data/config";
import { DEFAULT_LANG, SUPPORTED_LANGS, t } from "../i18n/index";
import { stripLangPrefix } from "../i18n/paths";
import { THEME_COLORS } from "../lib/theme";

interface Props {
  title: string;
  description?: string;
  /** 分享图站点内路径或绝对 URL，默认品牌图 */
  image?: string;
  type?: "website" | "article";
  /** 重定向桩/404 等设为 true */
  noindex?: boolean;
  /** 仅语言首页输出 WebSite 结构化数据 */
  includeWebsiteJsonLd?: boolean;
  /** 文章页发布时间（ISO 字符串） */
  publishedTime?: string;
}

/** 品牌默认分享图（唯一尺寸已知的图，见下方 og:image:width/height 的条件） */
const OG_DEFAULT_IMAGE = "/images/og-default.png";

const {
  title,
  // 默认描述按 locale 取 i18n：原先固定用中文 SITE_DESCRIPTION，会让省略 description
  // 的页面（如 404）在英文站点输出中文描述
  description = t(Astro.currentLocale ?? DEFAULT_LANG, "common.site.description"),
  image = OG_DEFAULT_IMAGE,
  type = "website",
  noindex = false,
  includeWebsiteJsonLd = false,
  publishedTime,
} = Astro.props;

const site = Astro.site ?? new URL("https://lkm-ahz.icu");
const canonical = Astro.url.href;
const ogImage = new URL(image, site).href;
// 尺寸只对品牌图成立：文章页用的是远程分享图（内容里是 1200x650），
// 若一律声明 1200x630，抓取方按错误比例裁剪预览图
const ogImageIsDefault = image === OG_DEFAULT_IMAGE;

// 是否真的是带语言前缀的页面：不能用 currentLocale 是否为 undefined 判断——
// Astro 对 /404 这类非 [lang] 路由会回落到默认语言（zh），于是 404 会生成
// /zh/404/、/en/404/ 这些并不存在的 hreflang alternate，并自称 og:locale=zh_CN。
// 用「剥掉前缀后路径是否变化」来判定，语言中立的页面就不再声明语言相关元信息。
const pathname = Astro.url.pathname;
const localized = stripLangPrefix(pathname) !== pathname;
const locale = Astro.currentLocale as "zh" | "en" | undefined;
const ogLocale =
  !localized || locale === undefined
    ? undefined
    : locale === "en"
      ? "en_US"
      : "zh_CN";
const ogLocaleAlternate =
  !localized || locale === undefined
    ? undefined
    : locale === "en"
      ? "zh_CN"
      : "en_US";

// 去掉语言前缀得到语言中立路径，用于生成各语言 alternate
// （前缀集合由 SUPPORTED_LANGS 派生，新增语言时这里的匹配不会落后于配置）
const pathWithoutLocale = localized ? stripLangPrefix(pathname) : "/";
const alternates = localized
  ? SUPPORTED_LANGS.map((lang) => ({
      lang,
      href: getAbsoluteLocaleUrl(lang, pathWithoutLocale),
    }))
  : [];
const xDefault = localized
  ? getAbsoluteLocaleUrl(DEFAULT_LANG, pathWithoutLocale)
  : undefined;

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": new URL("/#organization", site).href,
  name: SITE_NAME,
  alternateName: "LKM",
  // 组织 URL 用站点根，而不是写死中文首页：英文/中立页面不该把 /zh/ 报成机构地址
  url: new URL("/", site).href,
  logo: new URL("/lkm-logo.svg", site).href,
  foundingDate: "2014",
};
const websiteJsonLd = includeWebsiteJsonLd
  ? {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": new URL("/#website", site).href,
      name: SITE_NAME,
      url: canonical,
      inLanguage: locale === "en" ? "en" : "zh-CN",
      publisher: { "@id": organizationJsonLd["@id"] },
    }
  : null;
const articleJsonLd =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "Article",
        headline: title,
        description,
        image: ogImage,
        inLanguage: locale === "en" ? "en" : "zh-CN",
        ...(publishedTime ? { datePublished: publishedTime } : {}),
        publisher: { "@id": organizationJsonLd["@id"] },
      }
    : null;
---

<link rel="canonical" href={canonical} />
<link rel="icon" href="/lkm-logo.svg" type="image/svg+xml" />

<meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
<!-- 初始值对应默认的白天主题；ThemeToggle 的脚本会在切主题时改写 -->
<meta name="theme-color" content={THEME_COLORS.day} />
{description && <meta name="description" content={description} />}

{
  alternates.map((a) => (
    <link rel="alternate" hreflang={a.lang} href={a.href} />
  ))
}
{xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
{ogImageIsDefault && (
  <>
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </>
)}
<meta
  property="og:image:alt"
  content={locale === "en" ? `${SITE_NAME} official share image` : `${SITE_NAME} 官方分享图`}
/>
{ogLocale && <meta property="og:locale" content={ogLocale} />}
{localized && <meta property="og:locale:alternate" content={ogLocaleAlternate} />}
{type === "article" && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={ogImage} />

{/* 文档页配图来自远程图床，提前做 DNS 预解析 */}
<link rel="dns-prefetch" href="https://picsum.photos" />

<script is:inline type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
{websiteJsonLd && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
)}
{articleJsonLd && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
)}
