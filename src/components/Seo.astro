---
/**
 * 统一 head 元信息：canonical / Open Graph / Twitter / hreflang / JSON-LD。
 * 由 OfficialLayout 渲染一次；不要在别处重复引入，否则会产生重复标签。
 */
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { SITE_DESCRIPTION, SITE_NAME } from "../data/config";
import { SUPPORTED_LANGS } from "../i18n/index";
import { THEME_COLORS } from "../lib/theme";

interface Props {
  title: string;
  description?: string;
  /** 分享图站点内路径或绝对 URL，默认品牌图 */
  image?: string;
  type?: "website" | "article";
  /** 重定向桩/404 等设为 true */
  noindex?: boolean;
  /** 仅语言首页输出 WebSite 结构化数据 */
  includeWebsiteJsonLd?: boolean;
  /** 文章页发布时间（ISO 字符串） */
  publishedTime?: string;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = "/images/og-default.png",
  type = "website",
  noindex = false,
  includeWebsiteJsonLd = false,
  publishedTime,
} = Astro.props;

const site = Astro.site ?? new URL("https://lkm-ahz.icu");
const canonical = Astro.url.href;
const ogImage = new URL(image, site).href;

// 404 等非 [lang] 路由下 currentLocale 为 undefined，此时不生成 hreflang
const locale = Astro.currentLocale as "zh" | "en" | undefined;
const localized = locale !== undefined;
const ogLocale = locale === "en" ? "en_US" : "zh_CN";
const ogLocaleAlternate = locale === "en" ? "zh_CN" : "en_US";

// 去掉语言前缀得到语言中立路径，用于生成各语言 alternate
const pathWithoutLocale = localized
  ? Astro.url.pathname.replace(/^\/(zh|en)(?=\/|$)/, "") || "/"
  : "/";
const alternates = localized
  ? SUPPORTED_LANGS.map((lang) => ({
      lang,
      href: getAbsoluteLocaleUrl(lang, pathWithoutLocale),
    }))
  : [];
const xDefault = localized ? getAbsoluteLocaleUrl("zh", pathWithoutLocale) : undefined;

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": new URL("/#organization", site).href,
  name: SITE_NAME,
  alternateName: "LKM",
  url: new URL("/zh/", site).href,
  logo: new URL("/favicon.svg", site).href,
  foundingDate: "2014",
};
const websiteJsonLd = includeWebsiteJsonLd
  ? {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": new URL("/#website", site).href,
      name: SITE_NAME,
      url: canonical,
      inLanguage: locale === "en" ? "en" : "zh-CN",
      publisher: { "@id": organizationJsonLd["@id"] },
    }
  : null;
const articleJsonLd =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "Article",
        headline: title,
        description,
        image: ogImage,
        inLanguage: locale === "en" ? "en" : "zh-CN",
        ...(publishedTime ? { datePublished: publishedTime } : {}),
        publisher: { "@id": organizationJsonLd["@id"] },
      }
    : null;
---

<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />

<meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
<!-- 初始值对应默认的白天主题；ThemeToggle 的脚本会在切主题时改写 -->
<meta name="theme-color" content={THEME_COLORS.day} />
{description && <meta name="description" content={description} />}

{
  alternates.map((a) => (
    <link rel="alternate" hreflang={a.lang} href={a.href} />
  ))
}
{xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
  property="og:image:alt"
  content={locale === "en" ? `${SITE_NAME} official share image` : `${SITE_NAME} 官方分享图`}
/>
<meta property="og:locale" content={ogLocale} />
{localized && <meta property="og:locale:alternate" content={ogLocaleAlternate} />}
{publishedTime && <meta property="article:published_time" content={publishedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={ogImage} />

{/* 文档页配图来自远程图床，提前做 DNS 预解析 */}
<link rel="dns-prefetch" href="https://picsum.photos" />

<script is:inline type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
{websiteJsonLd && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
)}
{articleJsonLd && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
)}
