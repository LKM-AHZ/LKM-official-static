---
import { coverGradient, formatDate } from "./format";

/**
 * 文章卡片：顶部封面（有 image 显示真实图；无则回退到标题色相渐变），
 * 摘要、标签与底部元信息。全卡为链接，适配等高网格。
 */
interface Props {
  lang: "zh" | "en";
  href: string;
  title: string;
  desc?: string;
  date: Date;
  minutes: number;
  /** 文章的完整标签；卡片底部渲染为 chip，并下发 data-tags 供 /news 筛选 */
  tags?: string[];
  image?: string;
  /** 供 /news 客户端搜索比对的归一化文本；首页不传，属性随之不渲染 */
  searchText?: string;
}

const { lang, href, title, desc, date, minutes, tags = [], image, searchText } =
  Astro.props;
const dateLabel = formatDate(date, lang);
const minutesLabel = lang === "en" ? `${minutes} min read` : `${minutes} 分钟`;
const gradient = coverGradient(title);
---

<div
  class="card-hover group flex h-full flex-col rounded-2xl"
  data-news-card
  data-search-text={searchText}
  data-tags={tags.length > 0 ? JSON.stringify(tags) : undefined}
>
  <div
    class="relative h-40 w-full shrink-0 overflow-hidden md:h-44"
    style={image ? undefined : { background: gradient }}
  >
    {image ? (
      <img
        src={image}
        alt={title}
        width={1200}
        height={630}
        loading="lazy"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    ) : undefined}
  </div>

  <div class="flex flex-1 flex-col p-6 pt-5">
    {/* 链接只包标题（可访问名就是标题，不再把摘要/日期/时长都念出来），
        再用 ::after 铺满整卡保留「整卡可点」的命中区 */}
    <h2 class="text-lg font-bold leading-snug text-deep-text">
      <a
        href={href}
        class="no-underline transition-colors group-hover:text-primary after:absolute after:inset-0 after:content-['']"
      >
        {title}
      </a>
    </h2>

    {desc && <p class="mt-2 text-sm leading-relaxed text-text-muted line-clamp-3">{desc}</p>}

    {
      tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <span class="rounded-full border border-[var(--card-edge)] bg-[var(--social-bg)] px-2 py-0.5 text-[11px] leading-none text-text-muted">
              {tag}
            </span>
          ))}
        </div>
      )
    }

    <div class="mt-auto flex items-center gap-3 pt-5 text-xs text-text-muted">
      <time datetime={date.toISOString().slice(0, 10)}>{dateLabel}</time>
      <span class="h-1 w-1 rounded-full bg-surface-3" />
      <span>{minutesLabel}</span>
    </div>
  </div>
</div>

<style>
  /* 卡内链接必须保持 static。tech.css 的 `body.tech-theme a` 给了全局
     position: relative，标题链接因此成为自身 ::after 的定位祖先，
     after:inset-0 便只铺满标题那一小块而非整卡，「整卡可点」随之失效。
     拉回 static 后，::after 重新以 .card-hover（relative）为包含块。
     scoped 样式带 data-astro-cid 属性，特异性高于 body.tech-theme a。 */
  body.tech-theme .card-hover a {
    position: static;
  }
</style>
