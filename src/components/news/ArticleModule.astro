---
import type { CollectionEntry } from "astro:content";
import NewsCard from "./NewsCard.astro";
import { readingMinutes } from "./format";
import { buildSearchText } from "./search";
import { postSlug } from "./posts";
import type { TagCount } from "./tags";
import { langUrl } from "../../i18n/paths";

/**
 * 文章模块：四个标签页共用同一套标签栏、卡片网格、空状态与分页条。
 * 搜索框与左右切换放在页面层；标签栏跟随当前标签页，切换时一并更换。
 */
interface Props {
  /** 锚点/标题 id 前缀，如 news、guides */
  id: string;
  lang: "zh" | "en";
  title: string;
  subtitle: string;
  items: CollectionEntry<"docs">[];
  kind: "news" | "guide" | "project" | "studio";
  /** 模块计数单位：新闻、文档、项目或工作室 */
  unit: "news" | "docs" | "projects" | "studios";
  /** 当前模块的标签及出现次数，渲染在左右切换下方 */
  tags: TagCount[];
  /** 「全部」标签文案 */
  tagsAllLabel: string;
  /** 标签筛选栏的无障碍名称 */
  tagsAriaLabel: string;
  /** 每页文章数，默认 6 */
  pageSize?: number;
  /** 当前筛选下没有内容时的提示 */
  emptyText: string;
}

const {
  id,
  lang,
  title,
  subtitle,
  items,
  kind,
  unit,
  tags,
  tagsAllLabel,
  tagsAriaLabel,
  pageSize = 6,
  emptyText,
} = Astro.props;

const countTemplates = {
  news: lang === "en" ? "{n} news" : "{n} 篇新闻",
  docs: lang === "en" ? "{n} docs" : "{n} 篇文档",
  projects: lang === "en" ? "{n} projects" : "{n} 个项目",
  studios: lang === "en" ? "{n} studios" : "{n} 个工作室",
};
const countTemplate = countTemplates[unit];
const countText = countTemplate.replace("{n}", String(items.length));
const prevLabel = lang === "en" ? "← Previous" : "← 上一页";
const nextLabel = lang === "en" ? "Next →" : "下一页 →";
const pagerLabel = lang === "en" ? `${title} pagination` : `${title}分页`;
---

<section
  data-module={id}
  data-page-size={pageSize}
  aria-labelledby={`${id}-title`}
>
  <h2 id={`${id}-title`} class="sr-only">{title}</h2>

  {
    tags.length > 0 && (
      <div
        data-module-tagbar
        role="group"
        aria-label={tagsAriaLabel}
        class="mx-auto mt-6 flex max-w-3xl flex-wrap items-center justify-center gap-2"
      >
        <button
          type="button"
          data-tag-filter=""
          aria-pressed="true"
          class="inline-flex items-center gap-1.5 rounded-full border border-[var(--card-edge)] bg-[var(--social-bg)] px-3 py-1 text-xs text-text-muted transition hover:border-[var(--primary)] hover:text-primary aria-pressed:border-[var(--primary)] aria-pressed:bg-[var(--social-hover-bg)] aria-pressed:font-medium aria-pressed:text-primary"
        >
          {tagsAllLabel}
        </button>
        {tags.map(({ tag, count }) => (
          <button
            type="button"
            data-tag-filter={tag}
            aria-pressed="false"
            class="inline-flex items-center gap-1.5 rounded-full border border-[var(--card-edge)] bg-[var(--social-bg)] px-3 py-1 text-xs text-text-muted transition hover:border-[var(--primary)] hover:text-primary aria-pressed:border-[var(--primary)] aria-pressed:bg-[var(--social-hover-bg)] aria-pressed:font-medium aria-pressed:text-primary"
          >
            {tag}
            <span class="text-[11px] opacity-70">{count}</span>
          </button>
        ))}
      </div>
    )
  }

  <header class="mb-8 mt-8 flex flex-wrap items-baseline justify-between gap-3">
    <p class="m-0 text-note text-text-muted">{subtitle}</p>
    <span
      data-module-count
      data-count-template={countTemplate}
      class="text-sm text-text-muted"
    >
      {countText}
    </span>
  </header>

  <div data-module-list class="grid gap-5 sm:grid-cols-2">
    {
      items.map((doc) => (
        <NewsCard
          kind={kind}
          headingLevel={3}
          lang={lang}
          href={langUrl(lang, `/docs/${postSlug(doc)}`)}
          title={doc.data.title}
          desc={doc.data.description}
          date={doc.data.publishDate}
          minutes={readingMinutes(doc.body ?? "")}
          tags={doc.data.tags ?? []}
          image={doc.data.image}
          searchText={buildSearchText([
            doc.data.title,
            doc.data.description,
            ...(doc.data.tags ?? []),
          ])}
        />
      ))
    }
  </div>

  <p
    data-module-empty
    hidden
    class="rounded-2xl border border-[var(--card-edge)] bg-[var(--social-bg)] px-6 py-10 text-center text-sm text-text-muted"
  >
    {emptyText}
  </p>

  <nav data-module-pager aria-label={pagerLabel} class="mt-8">
    <div class="flex items-center justify-center gap-3">
      <button
        type="button"
        data-page-prev
        disabled
        class="inline-flex h-9 items-center rounded-full border border-[var(--card-edge)] bg-[var(--ghost-bg)] px-4 text-sm text-text-muted transition"
      >
        {prevLabel}
      </button>
      <span
        data-page-info
        aria-live="polite"
        class="min-w-20 text-center text-sm tabular-nums text-text-muted"
      >
        1 / 1
      </span>
      <button
        type="button"
        data-page-next
        disabled
        class="inline-flex h-9 items-center rounded-full border border-[var(--card-edge)] bg-[var(--ghost-bg)] px-4 text-sm text-text-muted transition"
      >
        {nextLabel}
      </button>
    </div>
  </nav>
</section>

<style>
  [data-page-prev]:disabled,
  [data-page-next]:disabled {
    cursor: not-allowed;
    opacity: 0.4;
  }

  [data-page-prev]:not(:disabled):hover,
  [data-page-next]:not(:disabled):hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  [data-page-prev]:focus-visible,
  [data-page-next]:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
</style>
