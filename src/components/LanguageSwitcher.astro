---
import { SUPPORTED_LANGS, t } from "../i18n/index";
import type { Lang } from "../i18n/index";

// 当前语言：Astro.currentLocale（在 [lang] 路由下由内置 i18n 提供）
const current = (Astro.currentLocale ?? "zh") as Lang;
const label: Record<Lang, string> = { zh: "中", en: "EN" };

/**
 * 目标语言同页 URL。
 */
function localizedHref(target: Lang): string {
  const pathname = Astro.url.pathname;
  const base = pathname.replace(/^\/(zh|en)(?=\/|$)/, "") || "/";
  if (target === "zh") {
    return base === "/" ? "/" : "/zh" + base;
  }
  const withLang = "/en" + (base === "/" ? "/" : base);
  return withLang === "/en/" ? "/en/" : withLang;
}
---
<nav class="flex items-center gap-1 text-sm" aria-label={t(current, "common.aria.language")}>
  {
    SUPPORTED_LANGS.map((lang) => (
      <a
        href={localizedHref(lang)}
        hreflang={lang}
        lang={lang}
        aria-current={lang === current ? "true" : undefined}
        class:list={[
          "rounded-md px-2 py-1 text-sm font-semibold no-underline transition-colors",
          lang === current
            ? "text-[var(--primary)]"
            : "text-text-muted hover:text-[var(--primary)]",
        ]}
      >
        {label[lang]}
      </a>
    ))
  }
</nav>
