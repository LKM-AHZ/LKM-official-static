---
import "../styles/main.css";
import Icon from "../components/Icon.astro";
import BrandMark from "../components/BrandMark.astro";
import NavBar from "../components/NavBar.astro";
import TechBackground from "../components/TechBackground.astro";
import BackToTop from "../components/BackToTop.astro";
import Seo from "../components/Seo.astro";
import { SITE_NAME } from "../data/config"; // 品牌名不翻译，保持中文
import { t } from "../i18n/index";
import type { TranslationKey } from "../i18n/index";
import { langUrl } from "../i18n/paths";

/**
 * 官网首页布局（官方壳）：悬浮胶囊导航 + 科技感内容区 + 页脚，无侧边栏。
 * 视觉移植自「理科迷官网-源代码」，内容仍取自本仓库的 i18n / data。
 */
interface Props {
  title: string;
  description?: string;
  /** 当前路径（保留以兼容既有调用方；导航激活态由 NavBar 自行从 URL 推导） */
  currentPath?: string;
  /** 分享图站点内路径或绝对 URL */
  image?: string;
  type?: "website" | "article";
  /** 重定向桩/404 等设为 true */
  noindex?: boolean;
  /** 仅语言首页输出 WebSite 结构化数据 */
  includeWebsiteJsonLd?: boolean;
  /** 文章页发布时间（ISO 字符串） */
  publishedTime?: string;
  /**
   * 首屏是否通栏顶格（首页 Hero 用）：为 true 时不给 main 留导航高度，
   * 让 Hero 自身 min-h-screen 承接悬浮导航的遮挡。
   */
  overlayHero?: boolean;
}

const lang = (Astro.currentLocale ?? "zh") as string;
const {
  title,
  description,
  image,
  type,
  noindex,
  includeWebsiteJsonLd,
  publishedTime,
  overlayHero = false,
} = Astro.props;

// Footer 栏目（链接指向静态站现有页）
const footerCols: {
  titleKey: TranslationKey;
  links: { textKey: TranslationKey; href: string }[];
}[] = [
  {
    titleKey: "common.footer.col_community",
    links: [
      { textKey: "common.footer.team", href: "/team" },
      { textKey: "common.footer.management", href: "/team" },
      { textKey: "common.footer.timeline", href: "/" },
      { textKey: "common.footer.qq_groups", href: "/communities" },
    ],
  },
  {
    titleKey: "common.footer.col_pages",
    links: [
      { textKey: "common.nav_services", href: "/services" },
      { textKey: "common.footer.support_us", href: "/pricing" },
      { textKey: "common.footer.contact", href: "/contact" },
      { textKey: "common.footer.faq", href: "/" },
    ],
  },
  {
    titleKey: "common.footer.col_legal",
    links: [
      { textKey: "common.footer.privacy", href: "/about" },
      { textKey: "common.footer.terms", href: "/about" },
    ],
  },
];
---

<!doctype html>
<html lang={lang === "en" ? "en" : "zh-CN"} data-theme="day">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="generator" content={Astro.generator} />
    {/* 首屏前恢复主题，避免夜间用户先看到白天再闪一下 */}
    <script is:inline>
      (function () {
        let theme = "day";
        try {
          if (localStorage.getItem("likemi-theme") === "night") theme = "night";
        } catch {
          /* 隐私模式：保持默认 */
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <Seo
      title={title}
      description={description}
      image={image}
      type={type}
      noindex={noindex}
      includeWebsiteJsonLd={includeWebsiteJsonLd}
      publishedTime={publishedTime}
    />
  </head>
  <body class="tech-theme">
    <TechBackground />

    <header>
      <NavBar />
    </header>

    <main class={overlayHero ? undefined : "nav-offset"}>
      <slot />
    </main>

    <footer class="relative border-t border-[var(--card-edge)] py-14">
      <div class="container-x">
        <div class="flex flex-col justify-between gap-10 md:flex-row">
          <div class="md:max-w-sm">
            <div class="mb-4 flex items-center gap-2.5">
              <BrandMark size={34} />
              <span class="text-xl font-bold text-deep-text"
                >{SITE_NAME} LKM</span
              >
            </div>
            <p class="text-sm leading-7 text-text-muted">
              {t(lang, "common.site.description")}
            </p>
            <p class="mt-3 text-sm text-text-muted">
              {t(lang, "common.footer.tagline")}
            </p>
            <div class="mt-5 flex items-center gap-3">
              <a
                class="social-icon"
                aria-label={t(lang, "common.aria.github")}
                href="https://github.com/LKM-AHZ"
                target="_blank"
                rel="noopener"
              >
                <Icon name="github" class="w-5 h-[18px]" />
              </a>
              <a
                class="social-icon"
                aria-label={t(lang, "common.aria.rss")}
                href={langUrl(lang, "/")}
              >
                <Icon name="rss" class="w-5 h-[18px]" />
              </a>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
            {
              footerCols.map((col) => (
                <div>
                  <h4 class="mb-4 font-bold text-deep-text">
                    {t(lang, col.titleKey)}
                  </h4>
                  <ul class="space-y-2 text-sm">
                    {col.links.map((l) => (
                      <li>
                        <a
                          href={langUrl(lang, l.href)}
                          class="no-underline text-text-muted transition-colors hover:text-deep-text"
                        >
                          {t(lang, l.textKey)}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>

        <div
          class="mt-12 border-t border-[var(--card-edge)] pt-8 text-center text-sm text-text-muted"
        >
          {t(lang, "common.footer.copyright")}
        </div>
      </div>
    </footer>

    <BackToTop />
  </body>
</html>
