---
import "../styles/main.css";
import OfficialLayout from "./OfficialLayout.astro";
import Icon from "../components/Icon.astro";
import styles from "../components/CommunitySidebar.module.css";
import { t } from "../i18n/index";

/**
 * 官网侧栏布局（服务页用）：官方壳顶栏/页脚 + 左侧 #锚点侧栏 + 主内容偏移。
 * 复用 CommunitySidebar.module.css 的 shell/nav/icon/text/active 视觉。
 */
interface SidebarItem {
  text: string;
  href: string;
  icon: string;
}

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
  sidebarItems?: SidebarItem[];
  /** 页面正文已自带 h1 时置 true，避免重复一级标题 */
  ownHeading?: boolean;
}

const lang = (Astro.currentLocale ?? "zh") as string;
const {
  title,
  description = t(lang, "common.site.description"),
  currentPath = "/services",
  sidebarItems = [],
  ownHeading = false,
} = Astro.props;
---

<OfficialLayout
  title={title}
  description={description}
  currentPath={currentPath}
>
  <div class="min-h-screen">
    <nav
      class={styles.shell}
      data-page-sidebar
      aria-label={t(lang, "common.aria.page_toc")}
    >
      <ul class={styles.nav}>
        {
          sidebarItems.map((item) => (
            <li id={`side-${item.href.slice(1)}`}>
              <a href={item.href}>
                <div class={styles.icon}>
                  <Icon name={item.icon} />
                </div>
                <div class={styles.text}>{item.text}</div>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class={styles.mainShell}>
      {/* 正文由 section/h2 组成的页面补一个页面级 h1，保证标题层级完整 */}
      {!ownHeading && <h1 class="sr-only">{title}</h1>}
      <div class="max-w-7xl mx-auto px-4 md:px-6 py-16 md:py-20 lg:py-24">
        <slot />
      </div>
    </div>
  </div>
</OfficialLayout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const sidebar = document.querySelector("[data-page-sidebar]");
    if (!sidebar) return;
    const links = sidebar.querySelectorAll("a[href^='#']");

    function updateActive(): void {
      let current = "";
      for (const sec of document.querySelectorAll("section[id]")) {
        const rect = sec.getBoundingClientRect();
        if (rect.top <= 140) current = sec.id;
      }
      links.forEach((a) => {
        const li = a.closest("li");
        if (!li) return;
        const active = li.id === `side-${current}`;
        li.classList.toggle("pg-active", active);
      });
    }

    links.forEach((a) => {
      a.addEventListener("click", (e) => {
        const id = a.getAttribute("href");
        if (!id || !id.startsWith("#")) return;
        const target = document.querySelector(id);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: "smooth" });
        }
      });
    });

    window.addEventListener("scroll", () => {
      requestAnimationFrame(updateActive);
    });
    updateActive();
  });
</script>

<style>
  /* 页内侧栏 active（与顶栏 .nav-underline 同语言：淡底 + 左缘渐变竖线微光） */
  .pg-active {
    position: relative;
    background: var(--social-hover-bg);
    border-radius: 0.875rem;
  }
  .pg-active::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    translate: 0 -50%;
    width: 2px;
    height: 58%;
    border-radius: 9999px;
    background: linear-gradient(180deg, #7fd4ff, #b9c8ff);
    box-shadow: 0 0 8px rgba(127, 212, 255, 0.6);
  }
  .pg-active a > div {
    color: var(--primary);
  }
</style>
