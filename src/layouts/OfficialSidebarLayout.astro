---
import "../styles/main.css";
import OfficialLayout from "./OfficialLayout.astro";
import Icon from "../components/Icon.astro";
import styles from "../components/CommunitySidebar.module.css";
import { t } from "../i18n/index";

/**
 * 官网侧栏布局（服务页用）：官方壳顶栏/页脚 + 左侧 #锚点侧栏 + 主内容偏移。
 * 复用 CommunitySidebar.module.css 的 shell/nav/icon/text/active 视觉。
 */
interface SidebarItem {
  text: string;
  href: string;
  icon: string;
}

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
  sidebarItems?: SidebarItem[];
  /** 页面正文已自带 h1 时置 true，避免重复一级标题 */
  ownHeading?: boolean;
}

const lang = (Astro.currentLocale ?? "zh") as string;
const {
  title,
  description = t(lang, "common.site.description"),
  currentPath = "/about",
  sidebarItems = [],
  ownHeading = false,
} = Astro.props;
---

<OfficialLayout
  title={title}
  description={description}
  currentPath={currentPath}
>
  <div class="min-h-screen">
    {/* 无侧栏项时整块侧栏（含主内容偏移）都不渲染：空 <nav> 既是无意义的
        地标，也会白占 240px 版面（en 阶段一分类为空即此情形）。 */}
    {sidebarItems.length > 0 && (
      <>
        {/* 移动端：侧栏是画外抽屉（默认移出画外），这枚按钮在左下角把它拉出来。
            桌面端由 CSS 隐藏，侧栏照旧常驻左侧。 */}
        <button
          type="button"
          class={styles.mobileToggle}
          data-sidebar-toggle
          aria-controls="page-sidebar"
          aria-expanded="false"
          aria-label={t(lang, "common.aria.page_toc")}
        >
          <Icon name="menu" class={styles.iconMenu} />
          <Icon name="close" class={styles.iconClose} />
        </button>
        {/* 遮罩只是点击关闭的辅助手段：键盘用 Esc 关闭，按钮也可再次点击 */}
        <div
          class={styles.backdrop}
          data-sidebar-backdrop
          aria-hidden="true"
        ></div>
      </>
    )}

    {sidebarItems.length > 0 && (
      <nav
        id="page-sidebar"
        class={styles.shell}
        data-page-sidebar
        aria-label={t(lang, "common.aria.page_toc")}
      >
        <ul class={styles.nav}>
          {sidebarItems.map((item) => (
            <li id={`side-${item.href.slice(1)}`}>
              <a href={item.href}>
                <div class={styles.icon}>
                  <Icon name={item.icon} />
                </div>
                <div class={styles.text}>{item.text}</div>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <div
      class:list={[
        styles.mainShell,
        sidebarItems.length === 0 && styles.mainShellFull,
      ]}
    >
      {/* 正文由 section/h2 组成的页面补一个页面级 h1，保证标题层级完整 */}
      {!ownHeading && <h1 class="sr-only">{title}</h1>}
      <div
        class="max-w-7xl mx-auto px-4 md:px-6 py-16 md:py-20 lg:py-24"
        data-page-content
      >
        <slot />
      </div>
    </div>
  </div>
</OfficialLayout>

<script>
  import { trackActiveSection } from "../lib/active-section";

  // ── 移动端侧栏抽屉 ──
  // 手机上没有常驻侧栏的空间：默认移出画外（正文占满整宽），点左下角按钮滑入。
  // 状态放在 html.sidebar-open 上，CSS 只管画法与位移，JS 只管状态与无障碍属性。
  document.addEventListener("DOMContentLoaded", () => {
    const drawer = document.querySelector<HTMLElement>("[data-page-sidebar]");
    const toggle = document.querySelector<HTMLButtonElement>(
      "[data-sidebar-toggle]",
    );
    const backdrop = document.querySelector<HTMLElement>(
      "[data-sidebar-backdrop]",
    );
    if (!drawer || !toggle) return;

    const mobile = window.matchMedia("(max-width: 767px)");

    function setDrawer(open: boolean): void {
      const isOpen = mobile.matches && open;
      document.documentElement.classList.toggle("sidebar-open", isOpen);
      toggle?.setAttribute("aria-expanded", String(isOpen));
      if (backdrop) backdrop.hidden = !isOpen;
      // 收起时抽屉仍在 DOM 里：用 inert 把它从 Tab 顺序与无障碍树摘掉，
      // 否则键盘会跳进画外那些看不见的锚点上。桌面端侧栏常驻，不能 inert。
      if (drawer) drawer.inert = mobile.matches && !isOpen;
    }

    toggle.addEventListener("click", () => {
      setDrawer(!document.documentElement.classList.contains("sidebar-open"));
    });
    backdrop?.addEventListener("click", () => setDrawer(false));
    // Esc 关抽屉并把焦点还给按钮（键盘用户的出口）
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      if (!document.documentElement.classList.contains("sidebar-open")) return;
      setDrawer(false);
      toggle.focus();
    });
    // 点了抽屉里的锚点就收起：否则跳过去的区块会被抽屉盖住
    drawer.addEventListener("click", (event) => {
      if ((event.target as Element | null)?.closest("a")) {
        // 先完成链接的原生默认动作；同步设 inert 会让浏览器取消本次锚点跳转。
        setTimeout(() => setDrawer(false), 0);
      }
    });
    // 跨断点（旋转屏幕/拖动窗口）时复位，避免桌面态残留 sidebar-open
    mobile.addEventListener("change", () => setDrawer(false));
    setDrawer(false);
  });

  document.addEventListener("DOMContentLoaded", () => {
    const sidebar = document.querySelector("[data-page-sidebar]");
    if (!sidebar) return;
    const links = sidebar.querySelectorAll("a[href^='#']");
    // 只在布局正文区内收集锚点目标并缓存：全文档 querySelectorAll 会连页面其它
    // section 一起算，且每帧重新收集 + 逐个 getBoundingClientRect 会反复强制重排
    const content = document.querySelector("[data-page-content]");
    const sections = content
      ? Array.from(content.querySelectorAll<HTMLElement>("section[id]"))
      : [];

    // 只在活动项变化时更新样式和无障碍状态。
    trackActiveSection(sections, 140, (index) => {
      const current = sections[index]?.id ?? "";
      links.forEach((a) => {
        const li = a.closest("li");
        if (!li) return;
        const active = li.id === `side-${current}`;
        li.classList.toggle("pg-active", active);
        if (active) a.setAttribute("aria-current", "location");
        else a.removeAttribute("aria-current");
      });
    });
  });
</script>

<style>
  /* 页内侧栏 active（与顶栏 .nav-underline 同语言：淡底 + 左缘渐变竖线微光） */
  .pg-active {
    position: relative;
    background: var(--social-hover-bg);
    border-radius: 0.875rem;
  }
  .pg-active::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    translate: 0 -50%;
    width: 2px;
    height: 58%;
    border-radius: 9999px;
    background: linear-gradient(
      180deg,
      var(--accent-line-from),
      var(--accent-line-to)
    );
    box-shadow: 0 0 8px var(--accent-line-glow);
  }
  .pg-active a > div {
    color: var(--primary);
  }
</style>
