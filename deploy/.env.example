# 官网独立部署环境变量：复制为 deploy/.env 后按需修改（.env 已被 .gitignore 忽略）。
# compose 在本目录执行时自动读取 deploy/.env，无需 --env-file。

# 官网域名（**唯一来源**）：nginx 的 server_name、证书路径 /etc/letsencrypt/live/<域>、
# TLS SNI 全部由它派生。换域名只改这一处，但需重新签发证书（见 ../DEPLOYMENT.md）。
LKM_SITE_DOMAIN=lkm-ahz.icu

# Let's Encrypt 首次签发用的联系邮箱（续期不依赖它，只在首次 certonly 时使用）。
LKM_ACME_EMAIL=

# 对外端口（默认 80/443）。仅在有端口冲突、或前置于另一层反代时才需要改。
# LKM_HTTP_PORT=80
# LKM_HTTPS_PORT=443

# 容器重启策略：本仓沿用根仓同名变量的语义。默认 no（适合临时验证）；
# 服务器常驻**建议改为 unless-stopped**，否则宿主机重启后容器不会自动拉起。
LKM_RESTART_POLICY=no
