# 官网站点配置**模板**：容器启动时由 nginx 镜像自带的 20-envsubst-on-templates.sh
# 用环境变量展开 ${LKM_SITE_DOMAIN}，写入 /etc/nginx/conf.d/default.conf（覆盖镜像默认站点）。
# 该脚本只替换「已定义的」环境变量名，故 $host / $request_uri 等 nginx 变量不受影响。
#
# 只做独立部署必需的事：ACME、http→https、TLS、静态文件服务。
# 文本资源开启 gzip：构建产物本身未压缩，HTML/CSS/JS/SVG 传输量约降 60–70%。

server {
    listen 80;
    listen [::]:80;
    server_name ${LKM_SITE_DOMAIN} www.${LKM_SITE_DOMAIN};

    # ACME http-01 challenge 必须排在 301 之前（^~ 前缀匹配优先级高于 location /），
    # 否则 Let's Encrypt 的校验请求会被重定向到 https 而失败，证书无法签发/续期。
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    # 根入口一步跳到最终 HTTPS 中文首页，保留查询参数。
    location = / {
        return 301 https://$host/zh/$is_args$args;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${LKM_SITE_DOMAIN} www.${LKM_SITE_DOMAIN};

    # 证书由 certbot 卷提供：冷启动时是 certs-init 生成的自签占位，正式证书签发后
    # 由 99-cert-reload.sh 定期 nginx -s reload 生效。
    ssl_certificate     /etc/letsencrypt/live/${LKM_SITE_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${LKM_SITE_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    root /usr/share/nginx/html;
    index index.html;

    # 自建部署直接发 HTTP 重定向，省去 HTML 跳转桩的下载和解析。
    # GitHub Pages 等纯静态托管继续使用 dist/index.html 兜底。
    location = / {
        return 301 /zh/$is_args$args;
    }

    # 默认 nginx 不压缩文本；这些静态资源都是高压缩比内容。
    # text/html 默认就在 gzip_types 里，无需重复声明；woff2 已压缩，不再二次压缩。
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        application/javascript
        application/json
        application/xml
        image/svg+xml;
    gzip_vary on;
    # 构建时预压缩，避免每次响应都消耗 CPU；无 .gz 时仍由 gzip 动态兜底。
    gzip_static on;

    # Astro 文件名带内容哈希，内容变化会换 URL，可以安全地缓存一年。
    location ^~ /_astro/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # public/ 文件名未带哈希，短缓存并保留 ETag 校验，更新不会被长期锁住。
    location ~* \.(?:webp|png|jpe?g|svg|ico|woff2)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=86400";
    }

    # 多页静态站：不做 SPA fallback，未知路径如实 404。
    location / {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }
}
